test_stale_scope_checks_cannot_overwrite_terminal_or_authorized_state() {
  local tmp db repo git_wrapper real_git stale_pid stale_code out attempt
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git_wrapper="$tmp/blocked-git"
  real_git="$(command -v git)"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  git -C "$repo" commit --quiet --allow-empty --message base
  git -C "$repo" switch --quiet --create feature
  printf 'feature\n' > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message feature

  printf '%s\n' \
    '#!/bin/sh' \
    'case " $* " in' \
    '  *" diff --numstat "*)' \
    '    : > "$SCOPE_BLOCK_STARTED"' \
    '    while [ ! -e "$SCOPE_BLOCK_RELEASE" ]; do sleep 0.01; done' \
    '    ;;' \
    'esac' \
    'exec "$SCOPE_REAL_GIT" "$@"' > "$git_wrapper"
  chmod +x "$git_wrapper"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "completion race" --base main --scope-summary "Test terminal transition serialization." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "completion race" --base main --reason "Initial passing check." >/dev/null

  (stale_code=0; env GIT_BIN="$git_wrapper" SCOPE_REAL_GIT="$real_git" \
    SCOPE_BLOCK_STARTED="$tmp/complete.started" SCOPE_BLOCK_RELEASE="$tmp/complete.release" \
    "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
      --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
      --target "completion race" --base main --reason "Delayed stale completion check." \
      >"$tmp/complete.out" 2>"$tmp/complete.err" || stale_code=$?; \
    printf '%s\n' "$stale_code" > "$tmp/complete.code") &
  stale_pid=$!
  for attempt in {1..500}; do
    test -e "$tmp/complete.started" && break
    sleep 0.01
  done
  test -e "$tmp/complete.started" || fail "delayed scope-check did not reach the completion race"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "completion race" --base main --reason "The current review is complete." >/dev/null
  : > "$tmp/complete.release"
  wait "$stale_pid"
  stale_code="$(cat "$tmp/complete.code")"
  test "$stale_code" -ne 0 || fail "a stale scope-check must not reopen a completed budget"
  assert_contains "$tmp/complete.err" "scope budget changed while scope-check was measuring"
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-status \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "completion race" --base main)"
  assert_output_contains "$out" "SCOPE BUDGET COMPLETE"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "authorization race" --base main --scope-summary "Test authorization transition serialization." >/dev/null
  for number in {1..200}; do printf 'helper %s\n' "$number"; done > "$repo/helper.ts"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "authorization race" --base main --reason "The additional production line needs authorization." \
    >"$tmp/block.out" 2>"$tmp/block.err"; then
    fail "production-line growth beyond the budget should block before authorization"
  fi

  (stale_code=0; env GIT_BIN="$git_wrapper" SCOPE_REAL_GIT="$real_git" \
    SCOPE_BLOCK_STARTED="$tmp/authorize.started" SCOPE_BLOCK_RELEASE="$tmp/authorize.release" \
    "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
      --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
      --target "authorization race" --base main --reason "Delayed stale authorization check." \
      >"$tmp/authorize.out" 2>"$tmp/authorize.err" || stale_code=$?; \
    printf '%s\n' "$stale_code" > "$tmp/authorize.code") &
  stale_pid=$!
  for attempt in {1..500}; do
    test -e "$tmp/authorize.started" && break
    sleep 0.01
  done
  test -e "$tmp/authorize.started" || fail "delayed scope-check did not reach the authorization race"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-authorize \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "authorization race" --base main \
    --scope-summary "Include the explicitly approved production-line growth." \
    --authorization "User explicitly approved the production-line growth." >/dev/null
  : > "$tmp/authorize.release"
  wait "$stale_pid"
  stale_code="$(cat "$tmp/authorize.code")"
  test "$stale_code" -ne 0 || fail "a stale scope-check must not overwrite an authorized baseline"
  assert_contains "$tmp/authorize.err" "scope budget changed while scope-check was measuring"
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-status \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "authorization race" --base main)"
  assert_output_contains "$out" "SCOPE BUDGET READY"
  assert_output_contains "$out" "authorization=User explicitly approved the production-line growth."
}

