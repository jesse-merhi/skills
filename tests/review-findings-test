  assert_output_contains "$out" "SCOPE BUDGET COMPLETE"

  record_finding \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --decision-id CONSULT-001 \
    --status deferred --source review --fingerprint "shared parser contract" \
    --summary "Choose the shared parser contract." --decision "Track as an adjacent follow-up." \
    --owner-resolution declined \
    --text "The follow-up is explicitly deferred outside this review." >/dev/null

  if record_finding \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --decision-id LATE-001 \
    --status open --source review --fingerprint "late finding" \
    --summary "Late finding must not reopen a completed review." \
    --text "A delayed reviewer tried to write after completion." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "record must reject findings written after scope completion"
  fi
  assert_contains "$tmp/stderr" "scope budget is complete and terminal"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --command "pnpm test final" --result passed \
    --reason "Final validation after scope completion." --decision-id CONSULT-001 >/dev/null
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main)"
  assert_output_contains "$out" "SCOPE BUDGET COMPLETE"
  assert_output_contains "$out" "CONSULT-001 [deferred]"
  assert_output_contains "$out" "pnpm test final"
  assert_output_not_contains "$out" "LATE-001"
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout --json \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main)"
  printf '%s\n' "$out" | node -e '
    let input = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => { input += chunk; });
    process.stdin.on("end", () => {
      const closeout = JSON.parse(input);
      if (closeout.still_open.some((item) => item.decision_id === "CONSULT-001")) process.exit(1);
    });
  '

  node -e 'const { DatabaseSync } = require("node:sqlite"); const db = new DatabaseSync(process.argv[1]); db.prepare("insert into review_scope_locks (repo_key, branch, run_id) select review_runs.repo_key, coalesce(review_runs.branch, ?), review_runs.id from review_runs join review_scope_budgets on review_scope_budgets.run_id = review_runs.id where review_runs.target = ? and review_scope_budgets.status = ?").run("", "first review", "complete")' "$db"

  for terminal_command in scope-check scope-complete; do
    if "$ROOT_DIR/skills/code-review/scripts/review-findings" "$terminal_command" \
      --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
      --target "first review" --base main --reason "Completed budgets are terminal." \
      >"$tmp/stdout" 2>"$tmp/stderr"; then
      fail "$terminal_command must reject a completed scope budget"
    fi
    assert_contains "$tmp/stderr" "scope budget is complete and terminal"
  done
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-authorize \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --scope-summary "Reopen completed review." \
    --authorization "Caller text must not reopen terminal state." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-authorize must reject a completed scope budget"
  fi
  assert_contains "$tmp/stderr" "scope budget is complete and terminal"

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "later review" --base main --scope-summary "Later user-authorized review.")"
  assert_output_contains "$out" "SCOPE BUDGET READY"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "later review" --base main --reason "Later review is clean." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "later review" --base main --reason "Later review is complete." >/dev/null
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --scope-summary "Repeat the same review identity later.")"
  assert_output_contains "$out" "SCOPE BUDGET READY"
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main)"
  assert_output_not_contains "$out" "CONSULT-001"
}

test_review_scope_budget_uses_the_merge_base() {
  local tmp db repo out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  printf 'base\n' > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message base
  git -C "$repo" switch --quiet --create feature
  printf 'feature\n' >> "$repo/app.ts"
  git -C "$repo" commit --quiet --all --message feature
  git -C "$repo" switch --quiet main
  for number in {1..100}; do printf 'upstream %s\n' "$number"; done > "$repo/upstream.ts"
  git -C "$repo" add upstream.ts
  git -C "$repo" commit --quiet --message upstream
  git -C "$repo" switch --quiet feature

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "diverged review" --base main --scope-summary "One-line feature.")"
  assert_output_contains "$out" "baseline=1 current=1"
  assert_output_not_contains "$out" "upstream.ts"
}

test_review_scope_budget_measures_the_requested_head() {
  local tmp db repo target_head out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  git -C "$repo" commit --quiet --allow-empty --message base
  git -C "$repo" switch --quiet --create feature
  printf 'target\n' > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message target
  target_head="$(git -C "$repo" rev-parse HEAD)"
  for number in {1..100}; do printf 'later %s\n' "$number"; done > "$repo/later.ts"
  git -C "$repo" add later.ts
  git -C "$repo" commit --quiet --message later

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "requested commit review" --base main --head "$target_head" \
    --scope-summary "Review only the requested one-line commit.")"
  assert_output_contains "$out" "baseline=1 current=1"
  assert_output_not_contains "$out" "baseline=101"
}

