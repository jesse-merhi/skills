    --owner-resolution declined \
    --text "The follow-up is explicitly deferred outside this review." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --decision-id FOLLOWUP-001 \
    --status deferred --source review --fingerprint "adjacent formatter cleanup" \
    --summary "An adjacent formatter cleanup belongs in later work." \
    --finding-kind maintenance --fix-scope local --handling follow-up \
    "${MAINTENANCE_EVIDENCE[@]}" "${REPAIR_EVIDENCE[@]}" \
    --decision "Assign the formatter cleanup to its owning module after this PR." \
    --text "The current review records this as nonblocking follow-up work." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --command "pnpm test final" --result passed \
    --reason "Final validation before scope completion." --decision-id CONSULT-001 >/dev/null
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
