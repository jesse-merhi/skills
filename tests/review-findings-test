  assert_contains "$ROOT_DIR/INSTALL.md" "Verify Repo-Owned CLIs"
  assert_contains "$ROOT_DIR/README.md" 'Effect SQL `review-findings` CLI'
  assert_contains "$ROOT_DIR/INSTALL.md" 'Retire any `AGENT_REVIEW_FINDINGS_BIN` export'
  assert_contains "$skill_doc" "Read [references/findings-registry.md](references/findings-registry.md)."
  assert_contains "$findings_doc" "The findings database is the working registry."
  assert_contains "$findings_doc" 'Use the Effect SQL `review-findings` CLI as the local SQLite search index'
