  assert_contains "$tmp/stderr" "scope-complete requires every finding to be fixed, rejected, or explicitly deferred"
  assert_contains "$tmp/stderr" "CONSULT-001 [open]: Choose the shared parser contract."

  node -e 'const { DatabaseSync } = require("node:sqlite"); const db = new DatabaseSync(process.argv[1]); db.prepare("update issues set status = ?, owner_resolution = ? where decision_id = ?").run("deferred", "", "CONSULT-001")' "$db"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --reason "Legacy consult lacks owner resolution." \
