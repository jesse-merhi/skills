    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-complete must reject an uncommitted review tree"
  fi
  assert_contains "$tmp/stderr" "clean committed worktree"
  printf 'feature\n' > "$repo/app.ts"

  # Post-check drift past the allowance must block scope-complete and route to
  # scope-authorize, rather than closing on the stale passing check.
  { printf 'feature\n'; for number in {1..200}; do printf 'post-check change %s\n' "$number"; done; } > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message "grow past review budget"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --reason "Stale clean result." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-complete must remeasure the tree instead of trusting a stale passing check"
  fi
  assert_contains "$tmp/stderr" "SCOPE BUDGET BLOCKED"
  printf 'feature\n' > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message "restore reviewed tree"
  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-authorize \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --scope-summary "First review after restoring the approved tree." \
    --authorization "The user already authorized the original one-line feature scope." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --reason "Run the final clean review again." >/dev/null

  record_maintenance_finding \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --decision-id CONSULT-001 \
    --status open --source review --fingerprint "shared parser contract" \
    --summary "Choose the shared parser contract." --decision "Which shared parser contract should the owner approve?" \
    --text "User decision is still required." >/dev/null
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --reason "Unresolved consult remains." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-complete must reject unresolved findings"
