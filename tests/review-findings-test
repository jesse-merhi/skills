test_review_scope_budget_keeps_the_allowance_it_was_created_with() {
  local tmp db repo out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  printf 'base\n' > "$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit --quiet --message base
  git -C "$repo" switch --quiet --create feature
  for number in {1..40}; do printf 'line %s\n' "$number"; done > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message feature

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "PR #22" --base main --head "$(git -C "$repo" rev-parse HEAD)" \
    --scope-summary "A budget keeps the allowance it was created with." >/dev/null

  # Plant an allowance lower than the current rule would produce.
  node --input-type=module - "$db" <<'NODE'
import { DatabaseSync } from "node:sqlite"
const db = new DatabaseSync(process.argv[2])
db.exec("update review_scope_budgets set allowed_growth_lines = 5")
NODE

  # A budget keeps the allowance it was created with. Reading one never
  # rewrites it, so the stored bound stays the bound the review was held to and
  # the recorded status and event trail keep agreeing with it.
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-status \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "PR #22" --base main)"
  assert_output_contains "$out" "baseline=40 current=40 growth=0 allowed-growth=5 maximum=45"

  # The counts line reports stored numbers only. A rule rendered at print time
  # is computed from the current policy and would contradict this row, whose
  # allowance predates it.
  printf '%s\n' "$out" | grep -Fq -- "limit=" && {
    printf '%s\n' "$out" >&2
    fail "the scope counts line must not print a growth rule alongside a stored allowance"
  }
  assert_output_contains "$out" "maximum=45 production=40 tests=0 excluded-generated=0"

  # A manually frozen tighter allowance remains authoritative.
  for number in {41..46}; do printf 'fix %s\n' "$number"; done >> "$repo/app.ts"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "PR #22" --base main \
    --reason "A fix beyond the allowance this budget was created with." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "a budget must keep its stored allowance"
  fi
  assert_contains "$tmp/stderr" "SCOPE BUDGET BLOCKED"
  assert_contains "$tmp/stderr" "current=46 growth=6 allowed-growth=5"

  node --input-type=module - "$db" <<'NODE'
import { DatabaseSync } from "node:sqlite"
const db = new DatabaseSync(process.argv[2])
const row = db.prepare("select allowed_growth_lines as stored from review_scope_budgets").get()
if (row.stored !== 5) {
  console.error(`expected the stored allowance to be left at 5, found ${row.stored}`)
  process.exit(1)
}
