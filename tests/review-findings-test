      const d9b = byId.get("D9B");
      if (d9b?.status !== "deferred" || d9b.handling !== "follow-up" || d9b.disposition !== "follow-up") process.exit(1);
      if (!closeout.deferred_work.some((item) => item.decision_id === "D9B") || closeout.still_open.some((item) => item.decision_id === "D9B")) process.exit(1);
      if (byId.get("D11")?.owner_resolution !== "approved") process.exit(1);
      const d12 = byId.get("D12");
      if (d12?.status !== "reopened" || d12.owner_resolution !== "" || !closeout.still_open.some((item) => item.decision_id === "D12")) process.exit(1);
