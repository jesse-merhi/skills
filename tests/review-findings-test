#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_STATE_DIR="$(mktemp -d)"
trap 'rm -rf "$TEST_STATE_DIR"' EXIT

export AGENT_REVIEW_FINDINGS_BIN="$TEST_STATE_DIR/no-installed-review-findings"
export AGENT_REVIEW_FINDINGS_TARGET_DIR="$TEST_STATE_DIR/review-findings-target"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

assert_contains() {
  local file="$1"
  local text="$2"
  grep -Fq -- "$text" "$file" || {
    printf '%s\n' "--- $file ---" >&2
    sed -n '1,200p' "$file" >&2
    fail "expected $file to contain: $text"
  }
}

assert_output_contains() {
  local output="$1"
  local text="$2"
  printf '%s\n' "$output" | grep -Fq -- "$text" || {
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output to contain: $text"
  }
}

assert_output_not_contains() {
  local output="$1"
  local text="$2"
  if printf '%s\n' "$output" | grep -Fq -- "$text"; then
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output not to contain: $text"
  fi
}

test_review_findings_workflow_is_documented() {
  local skill_doc="$ROOT_DIR/skills/code-review/SKILL.md"
  local findings_doc="$ROOT_DIR/skills/code-review/references/findings-registry.md"
  local output_doc="$ROOT_DIR/skills/code-review/references/final-output.md"

  assert_contains "$ROOT_DIR/INSTALL.md" "Verify Repo-Owned CLIs"
  assert_contains "$ROOT_DIR/README.md" 'Effect SQL `review-findings` CLI'
  assert_contains "$skill_doc" "Read [references/findings-registry.md](references/findings-registry.md)."
  assert_contains "$findings_doc" "The findings database is the working registry."
  assert_contains "$findings_doc" 'Use the Effect SQL `review-findings` CLI as the local SQLite search index'
  assert_contains "$findings_doc" "--impact <ui|workflow|api-contract|permissions|privacy|finance|data-correctness|audit|migration|schema|internal>"
  assert_contains "$findings_doc" "--user-impact"
  assert_contains "$findings_doc" '"$review_findings_bin" closeout --material'
  assert_contains "$output_doc" "--branch <branch> --base <base> --target <current-target>"
  assert_contains "$output_doc" "Material findings"
  assert_contains "$output_doc" "User-visible or workflow changes"
  assert_contains "$output_doc" "Security, data, and permission changes"
  assert_contains "$output_doc" "Lower-risk findings"
}

test_review_findings_runs_from_repo_launcher() {
  local tmp out
  tmp="$(mktemp -d)"
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" path --db "$tmp/reviews.sqlite")"
  test "$out" = "$tmp/reviews.sqlite" || fail "repo launcher should run the Effect CLI"
}

test_review_findings_record_command_without_base_requires_existing_run() {
  local tmp db
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"

  if "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch missing-run \
    --target "PR #404" \
    --command "pnpm test missing-run" \
    --result passed \
    --reason "Should not attach to an unknown base-less run." \
    --decision-id D1 >/dev/null 2>"$tmp/stderr"; then
    fail "base-less record-command should fail when no matching run exists"
  fi

  assert_contains "$tmp/stderr" "record-command needs --base when no matching review run exists"
}

test_review_findings_cli_generates_closeout_from_records() {
  local tmp db out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --target "PR #88" \
    --base main \
    --decision-id D1 \
    --status fixed \
    --source native-review \
    --fingerprint "src/refunds.ts createRefund pending guard" \
    --summary "Pending refunds can allow duplicate provider refunds." \
    --impact data-correctness \
    --priority P1 \
    --material \
    --user-impact "Users could trigger duplicate provider refunds for the same payment." \
    --decision "Changed src/refunds.ts so pending refunds count as active." \
    --text "Review found the active refund guard ignored pending provider refunds." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --target "PR #88" \
    --base main \
    --decision-id D2 \
    --status open \
    --source cold-review \
    --fingerprint "src/invoices.ts loadInvoice tenant filter" \
    --summary "Invoice lookup still needs tenant-boundary confirmation." \
    --impact permissions \
    --priority P1 \
    --material \
    --user-impact "A tenant-boundary gap could expose invoice data across workspaces." \
    --decision "Awaiting owner confirmation." \
    --text "Cold review could not prove the tenant filter from the changed diff alone." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --target "PR #88" \
    --base main \
    --decision-id D3 \
    --status fixed \
    --source native-review \
    --fingerprint "tests/refunds.test.ts helper name" \
    --summary "Internal refund test helper name was misleading." \
    --impact internal \
    --priority P4 \
    --decision "Renamed the helper in the focused test only." \
    --text "Low-risk internal review cleanup." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --target "PR #88" \
    --base main \
    --command "pnpm test refunds" \
    --result "passed" \
    --reason "Checks D1 duplicate refund guard." \
    --decision-id D1 >/dev/null

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --base main \
    --target "PR #88")"

  assert_output_contains "$out" "Findings found"
  assert_output_contains "$out" "Material findings"
  assert_output_contains "$out" "D1 [fixed] native-review [data-correctness, p1]"
  assert_output_contains "$out" "why it matters: Users could trigger duplicate provider refunds"
  assert_output_contains "$out" "Security, data, and permission changes"
  assert_output_contains "$out" "Lower-risk findings"
  assert_output_contains "$out" "D3 [fixed] native-review [internal, p4]"
  assert_output_contains "$out" "Changes made while reviewing"
  assert_output_contains "$out" "Changed src/refunds.ts"
  assert_output_contains "$out" "Verification run"
  assert_output_contains "$out" "pnpm test refunds"
  assert_output_contains "$out" "Still open"
  assert_output_contains "$out" "D2 [open]"

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --material \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch fix-review-closeout \
    --base main \
    --target "PR #88")"

  assert_output_contains "$out" "Material findings"
  assert_output_contains "$out" "D1 [fixed] native-review [data-correctness, p1]"
  assert_output_contains "$out" "D2 [open] cold-review [permissions, p1]"
  assert_output_contains "$out" "Verification run"
  assert_output_not_contains "$out" "D3"
  assert_output_not_contains "$out" "Findings found"
}

test_review_findings_cli_covers_full_review_lifecycle_closeout() {
  local tmp db out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base main \
    --head review-head-1 \
    --decision-id D1 \
    --status open \
    --source native-review \
    --fingerprint "apps/web/settings.tsx role gated audit toggle" \
    --summary "Settings exposed an audit-history toggle to the wrong role." \
    --impact workflow \
    --priority P1 \
    --material \
    --user-impact "Admins could see and use a workflow control outside the intended permission model." \
    --decision "Fix before closeout." \
    --text "Native review found a role gate mismatch in the changed settings workflow." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base main \
    --head review-head-1 \
    --decision-id D2 \
    --status fixed \
    --source cold-review \
    --fingerprint "apps/web/audit-history.test.ts helper duplicate setup" \
    --summary "Audit-history test setup duplicated an internal helper." \
    --impact internal \
    --priority P4 \
    --decision "Collapsed the duplicate helper in the focused test." \
    --text "Low-risk internal cleanup found while reviewing the audit-history tests." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base main \
    --head review-head-1 \
    --decision-id D3 \
    --status deferred \
    --source cold-review \
    --fingerprint "apps/api/audit-history.ts export contract timestamp cursor" \
    --summary "Audit-history export cursor contract still needs owner confirmation." \
    --impact api-contract \
    --priority P2 \
    --user-impact "Consumers may depend on timestamp cursor ordering when exporting audit events." \
    --decision "Deferred pending owner confirmation." \
    --text "Cold review could not prove the export cursor contract from the changed diff alone." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base main \
    --head review-head-2 \
    --decision-id D1 \
    --status fixed \
    --source native-review \
    --fingerprint "apps/web/settings.tsx role gated audit toggle" \
    --summary "Settings exposed an audit-history toggle to the wrong role." \
    --impact workflow \
    --priority P1 \
    --material \
    --user-impact "Admins could see and use a workflow control outside the intended permission model." \
    --decision "Hid the audit-history toggle behind the owner role gate." \
    --text "The role-gated workflow was fixed and rechecked." >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base main \
    --head review-head-2 \
    --command "pnpm test audit-history" \
    --result "passed" \
    --reason "Checks D1 role-gated audit-history workflow." \
    --decision-id D1 >/dev/null

  "$ROOT_DIR/skills/code-review/scripts/review-findings" record-command \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --target "audit-history feature" \
    --base stale-base \
    --head review-head-2 \
    --command "pnpm test stale-base" \
    --result "passed" \
    --reason "Wrong-base verification must not appear in the main-base closeout." \
    --decision-id D1 >/dev/null

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --material \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --base main \
    --target "audit-history feature")"

  assert_output_contains "$out" "D1 [fixed] native-review [workflow, p1]"
  assert_output_contains "$out" "D3 [deferred] cold-review [api-contract, p2]"
  assert_output_contains "$out" "why it matters: Consumers may depend on timestamp cursor ordering"
  assert_output_contains "$out" "pnpm test audit-history"
  assert_output_contains "$out" "Still open"
  assert_output_not_contains "$out" "D2"
  assert_output_not_contains "$out" "pnpm test stale-base"
  assert_output_not_contains "$out" "Findings found"

  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --db "$db" \
    --repo sample-app \
    --repo-path "$tmp/sample-app" \
    --branch audit-history \
    --base main \
    --target "audit-history feature")"

  assert_output_contains "$out" "D2 [fixed] cold-review [internal, p4]"
  assert_output_contains "$out" "Hid the audit-history toggle behind the owner role gate."
  assert_output_contains "$out" "D3 [deferred]"
  assert_output_not_contains "$out" "D1 [open]"
  assert_output_not_contains "$out" "pnpm test stale-base"
}

test_review_findings_upgrades_legacy_schema() {
  local tmp db out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  node --input-type=module - "$db" <<'NODE'
import { DatabaseSync } from "node:sqlite"
const db = new DatabaseSync(process.argv[2])
db.exec(`
  create table review_runs (id text primary key, repo_name text not null, repo_path text not null, target text not null, base text, head text, status text not null, decision_log_path text, started_at integer, updated_at integer not null);
  create table issues (id text primary key, run_id text not null, decision_id text not null, status text not null, source text not null, fingerprint text not null, summary text not null, decision text, text text not null, decision_log_path text, updated_at integer not null, unique(run_id, decision_id));
`)
db.prepare("insert into review_runs values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)").run("legacy-run", "sample-app", process.argv[2], "PR #1", "main", "old-head", "active", "", 1, 1)
db.prepare("insert into issues values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)").run("legacy-issue", "legacy-run", "D0", "open", "legacy", "legacy", "Legacy finding", "", "legacy text", "", 1)
NODE
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" init --db "$db")"
  assert_output_contains "$out" "$db"
}

test_review_findings_reports_database_failures() {
  local tmp db
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  printf 'not a sqlite database\n' > "$db"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" init --db "$db" >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "corrupt database initialization should fail"
  fi
  test -s "$tmp/stderr" || fail "unexpected database failures must be reported on stderr"
}

test_review_findings_query_uses_latest_run_and_semantic_terms() {
  local tmp db out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  for base in old-base current-base; do
    "$ROOT_DIR/skills/code-review/scripts/review-findings" record --db "$db" --repo sample-app --repo-path "$tmp/sample-app" --branch query-branch --target "PR #9" --base "$base" --decision-id D1 --status open --source review --fingerprint "invoice lookup" --summary "$base invoice regression" --text "$base invoice lookup failure" >/dev/null
  done
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" query --db "$db" --repo sample-app --repo-path "$tmp/sample-app" --branch query-branch --target "PR #9" --json billing)"
  assert_output_contains "$out" "current-base invoice regression"
  assert_output_not_contains "$out" "old-base invoice regression"
}

test_review_findings_shares_history_across_git_worktrees() {
  local tmp db repo linked out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  linked="$tmp/linked"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  git -C "$repo" commit --quiet --allow-empty --message initial
  git -C "$repo" worktree add --quiet -b linked "$linked"
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record --db "$db" --repo sample-app --repo-path "$repo" --branch shared --target "PR #10" --base main --decision-id D1 --status open --source review --fingerprint "shared history" --summary "Worktree history remains visible." --text "shared finding" >/dev/null
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" query --db "$db" --repo sample-app --repo-path "$linked" --branch shared --target "PR #10" shared)"
  assert_output_contains "$out" "Worktree history remains visible."
}

test_review_findings_workflow_is_documented
test_review_findings_runs_from_repo_launcher
test_review_findings_record_command_without_base_requires_existing_run
test_review_findings_cli_generates_closeout_from_records
test_review_findings_cli_covers_full_review_lifecycle_closeout
test_review_findings_upgrades_legacy_schema
test_review_findings_reports_database_failures
test_review_findings_query_uses_latest_run_and_semantic_terms
test_review_findings_shares_history_across_git_worktrees

printf 'ok - review-findings tests\n'
