  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "requested commit review" --base main --head "$target_head" \
    --scope-summary "Review only the requested one-line commit.")"
  assert_output_contains "$out" "baseline=1 current=1"
  assert_output_not_contains "$out" "baseline=101"
}

