    --target "PR #12" --base main --reason "The fix converts a baseline text path to binary." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-check must block when a baseline text path becomes binary"
  fi
  assert_contains "$tmp/stderr" "- app.ts"
}

test_review_scope_budget_counts_tests_in_total_loc() {
