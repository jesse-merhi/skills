test_review_scope_budget_can_close_before_a_later_review() {
  local tmp db repo out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  printf 'base\n' > "$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit --quiet --message base
  git -C "$repo" switch --quiet --create feature
  printf 'feature\n' > "$repo/app.ts"
  git -C "$repo" add app.ts
  git -C "$repo" commit --quiet --message feature

  printf 'dirty\n' >> "$repo/app.ts"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --scope-summary "First review." \
    >"$tmp/stdout" 2>"$tmp/stderr"; then
    fail "scope-start must reject an uncommitted review tree"
  fi
  assert_contains "$tmp/stderr" "clean committed worktree"
  printf 'feature\n' > "$repo/app.ts"

  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --scope-summary "First review." >/dev/null
  "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-check \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "first review" --base main --reason "Run the final clean review." >/dev/null

  printf 'uncommitted\n' >> "$repo/app.ts"
  if "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-complete \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
