#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_STATE_DIR="$(mktemp -d)"
trap 'rm -rf "$TEST_STATE_DIR"' EXIT

export AGENT_REVIEW_FINDINGS_BIN="$TEST_STATE_DIR/no-installed-review-findings"
export AGENT_REVIEW_FINDINGS_TARGET_DIR="$TEST_STATE_DIR/review-findings-target"

MAINTENANCE_EVIDENCE=(
  --maintenance-evidence "The supported parser is duplicated across three changed modules."
  --present-cost "The branch adds reading and regression-test cost."
)

REPAIR_EVIDENCE=(--root-cause "The owning module does not enforce the current contract." --recommended-fix "Repair the contract in the owning module." --intervention-justification "The supported path is broken, and the owning repair is smaller than tolerating repeated failures.")
RUNTIME_ACTIONABILITY=(--contract-evidence "The supported workflow promises this behavior." "${REPAIR_EVIDENCE[@]}")

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

assert_contains() {
  local file="$1"
  local text="$2"
  grep -Fq -- "$text" "$file" || {
    printf '%s\n' "--- $file ---" >&2
    sed -n '1,200p' "$file" >&2
    fail "expected $file to contain: $text"
  }
}

assert_output_contains() {
  local output="$1"
  local text="$2"
  printf '%s\n' "$output" | grep -Fq -- "$text" || {
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output to contain: $text"
  }
}

assert_output_not_contains() {
  local output="$1"
  local text="$2"
  if printf '%s\n' "$output" | grep -Fq -- "$text"; then
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output not to contain: $text"
  fi
}

record_maintenance_finding() {
  local args=("$@")
  local decision_id="" fix_scope="local" handling="fix" index
  for ((index = 0; index < ${#args[@]}; index += 1)); do
    case "${args[$index]}" in
      --decision-id) decision_id="${args[$((index + 1))]}" ;;
    esac
  done
  if [[ "$decision_id" == CONSULT-* ]]; then
    fix_scope="systemic"
    handling="consult"
  fi
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --finding-kind maintenance --fix-scope "$fix_scope" --handling "$handling" \
    "${MAINTENANCE_EVIDENCE[@]}" "${REPAIR_EVIDENCE[@]}" \
    "${args[@]}"
}

record_runtime_finding() {
  local args=("$@")
  local decision_id="" fix_scope="local" handling="fix" index
  for ((index = 0; index < ${#args[@]}; index += 1)); do
    case "${args[$index]}" in
      --decision-id) decision_id="${args[$((index + 1))]}" ;;
    esac
  done
  if [[ "$decision_id" == CONSULT-* ]]; then
    fix_scope="systemic"
    handling="consult"
  fi
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --finding-kind runtime --fix-scope "$fix_scope" --handling "$handling" \
    "${RUNTIME_ACTIONABILITY[@]}" \
    "${args[@]}"
}

