test_review_scope_ignores_checkout_controlled_git() {
  local tmp db repo
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  repo="$tmp/repo"
  git init --quiet --initial-branch main "$repo"
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
  git -C "$repo" commit --quiet --allow-empty --message base
  git -C "$repo" switch --quiet --create feature
  mkdir "$repo/bin"
  printf '#!/bin/sh\nprintf compromised > %s\nexit 99\n' "$tmp/marker" > "$repo/bin/git"
  chmod +x "$repo/bin/git"
  printf 'feature\n' > "$repo/app.ts"

  env PATH="$repo/bin:$PATH" "$ROOT_DIR/skills/code-review/scripts/review-findings" scope-start \
    --db "$db" --repo sample-app --repo-path "$repo" --branch feature \
    --target "trusted git review" --base main --scope-summary "Use trusted Git." >/dev/null
  test ! -e "$tmp/marker" || fail "scope commands must not execute checkout-controlled Git"
}

