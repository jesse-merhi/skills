test_review_findings_upgrades_legacy_schema() {
  local tmp db out
  tmp="$(mktemp -d)"
  db="$tmp/reviews.sqlite"
  node --input-type=module - "$db" <<'NODE'
import { DatabaseSync } from "node:sqlite"
const db = new DatabaseSync(process.argv[2])
db.exec(`
  create table review_runs (id text primary key, repo_name text not null, repo_path text not null, target text not null, base text, head text, status text not null, decision_log_path text, started_at integer, updated_at integer not null);
  create table issues (id text primary key, run_id text not null, decision_id text not null, status text not null, source text not null, fingerprint text not null, summary text not null, decision text, text text not null, decision_log_path text, updated_at integer not null, unique(run_id, decision_id));
`)
db.prepare("insert into review_runs values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)").run("legacy-run", "sample-app", process.argv[2], "PR #1", "main", "old-head", "active", "", 1, 1)
db.prepare("insert into issues values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)").run("legacy-issue", "legacy-run", "D0", "open", "legacy", "legacy", "Legacy finding", "", "legacy text", "", 1)
NODE
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" init --db "$db")"
  assert_output_contains "$out" "$db"
  "$ROOT_DIR/skills/code-review/scripts/review-findings" record \
    --db "$db" --repo sample-app --repo-path "$db" --target "PR #1" --base main \
    --decision-id D0 --status fixed --source review --fingerprint legacy \
    --summary "Legacy finding updated." --text "updated" >/dev/null
  out="$("$ROOT_DIR/skills/code-review/scripts/review-findings" closeout \
    --db "$db" --repo sample-app --repo-path "$db" --target "PR #1" --base main)"
  assert_output_contains "$out" "D0 [fixed]"
  assert_output_contains "$out" "Legacy finding updated."
}

