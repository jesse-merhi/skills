  printf '%s\n' "$out" | node -e '
    let input = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => { input += chunk; });
    process.stdin.on("end", () => {
      const closeout = JSON.parse(input);
      if (!closeout.still_open.some((item) => item.decision_id === "LEGACY-DEFERRED")) process.exit(1);
      if (closeout.findings_found.find((item) => item.decision_id === "D0")?.severity !== "") process.exit(1);
    });
  '
}

