  [[ -z "$invalid_stdout" && -s "$net_diff_fixture/invalid-base.err" ]] || fail "invalid base must report only on stderr"
  assert_contains "$net_diff_fixture/invalid-base.err" 'Invalid base ref "missing-ref"'
  if invalid_stdout="$(cd "$net_diff_fixture" && "$skill/scripts/pr-net-diff" --head missing-ref --json 2>invalid-head.err)"; then fail "expected invalid head to fail"; fi
  [[ -z "$invalid_stdout" && -s "$net_diff_fixture/invalid-head.err" ]] || fail "invalid head must report only on stderr"
  assert_contains "$net_diff_fixture/invalid-head.err" 'Invalid head ref "missing-ref"'
  if invalid_stdout="$(cd "$net_diff_fixture" && "$skill/scripts/pr-net-diff" --json --base 2>missing-value.err)"; then fail "expected missing flag value to fail"; fi
  [[ -z "$invalid_stdout" && -s "$net_diff_fixture/missing-value.err" ]] || fail "parse failures must report only on stderr"
  if invalid_stdout="$(cd "$net_diff_fixture" && "$skill/scripts/pr-net-diff" --json --unknown 2>unknown-flag.err)"; then fail "expected unknown flag to fail"; fi
  [[ -z "$invalid_stdout" && -s "$net_diff_fixture/unknown-flag.err" ]] || fail "unknown flags must report only on stderr"
  unrelated_tree="$(printf '' | git -C "$net_diff_fixture" mktree)"
  unrelated_sha="$(printf 'Unrelated\n' | git -C "$net_diff_fixture" commit-tree "$unrelated_tree")"
  if invalid_stdout="$(cd "$net_diff_fixture" && "$skill/scripts/pr-net-diff" --base "$base_sha" --head "$unrelated_sha" --json 2>unrelated.err)"; then fail "expected unrelated refs to fail"; fi
  [[ -z "$invalid_stdout" && -s "$net_diff_fixture/unrelated.err" ]] || fail "unrelated refs must report only on stderr"
  rm -rf "$net_diff_fixture"

