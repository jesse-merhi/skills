test_examples_report_computed_values() {
  local retry_model="$ROOT_DIR/skills/html-explanations/assets/patterns/interactive-model.html"

  RETRY_MODEL="$retry_model" node --input-type=module <<'JS'
import fs from "node:fs"
import vm from "node:vm"

const html = fs.readFileSync(process.env.RETRY_MODEL, "utf8")
const script = html.match(/<script>([\s\S]*?)<\/script>/)?.[1]
if (script === undefined) throw new Error("interactive retry model has no inline script")

const element = (value = "") => ({
  value,
  textContent: "",
  innerHTML: "",
  style: {},
  listeners: new Map(),
  addEventListener(type, listener) {
    this.listeners.set(type, listener)
  },
})
const elements = new Map([
  ["attempts", element("5")],
  ["delay", element("30")],
  ["recovery", element("45")],
  ...[
    "attempts-value",
    "delay-value",
    "recovery-value",
    "wait-result",
    "recover-result",
    "recover-bar",
    "terminal-bar",
    "recover-bar-value",
    "terminal-bar-value",
    "reading",
  ].map((id) => [id, element()]),
])
const document = {
  getElementById(id) {
    const found = elements.get(id)
    if (found === undefined) throw new Error(`missing DOM stub for ${id}`)
    return found
  },
}

vm.runInNewContext(script, { document, Math, Number, String })
elements.get("attempts").value = "8"
elements.get("delay").value = "5"
elements.get("recovery").value = "10"
const trigger = (id) => {
  const update = elements.get(id).listeners.get("input")
  if (update === undefined) throw new Error(`${id} input listener was not registered`)
  update()
}
trigger("attempts")

if (elements.get("wait-result").textContent !== "10m 35s") {
  throw new Error("attempts listener did not render the changed retry wait")
}
if (!elements.get("reading").innerHTML.includes("after 10m 35s of modeled retry delay")) {
  throw new Error("attempts listener did not report the computed delay")
}

elements.get("attempts").value = "3"
elements.get("delay").value = "20"
trigger("delay")
if (elements.get("wait-result").textContent !== "1m") {
  throw new Error("delay listener did not render the changed retry wait")
}
if (!elements.get("reading").innerHTML.includes("after 1m of modeled retry delay")) {
  throw new Error("delay listener did not report the computed delay")
}

elements.get("attempts").value = "4"
elements.get("delay").value = "10"
elements.get("recovery").value = "80"
trigger("recovery")
if (elements.get("recover-result").textContent !== "99%") {
  throw new Error("recovery listener did not render the changed recovery rate")
}
if (!elements.get("reading").innerHTML.includes("balances transient recovery")) {
  throw new Error("recovery listener did not update the explanatory reading")
}
JS
}

