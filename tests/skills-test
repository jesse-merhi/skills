#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

assert_contains() {
  local file="$1"
  local text="$2"
  grep -Fq -- "$text" "$file" || {
    printf '%s\n' "--- $file ---" >&2
    sed -n '1,200p' "$file" >&2
    fail "expected $file to contain: $text"
  }
}

assert_not_contains() {
  local file="$1"
  local text="$2"
  if grep -Fq -- "$text" "$file"; then
    printf '%s\n' "--- $file ---" >&2
    sed -n '1,200p' "$file" >&2
    fail "expected $file not to contain: $text"
  fi
}

assert_output_contains() {
  local output="$1"
  local text="$2"
  printf '%s' "$output" | grep -Fq -- "$text" || {
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output to contain: $text"
  }
}

assert_output_not_contains() {
  local output="$1"
  local text="$2"
  if printf '%s' "$output" | grep -Fq -- "$text"; then
    printf '%s\n' "--- command output ---" >&2
    printf '%s\n' "$output" >&2
    fail "expected command output not to contain: $text"
  fi
}

test_skill_frontmatter_is_valid() {
  ROOT_DIR="$ROOT_DIR" python3 <<'PY'
from pathlib import Path
import ast
import os
import sys


def parse_scalar(value):
    value = value.strip()
    if value.startswith("'"):
        if not value.endswith("'"):
            raise ValueError("unterminated single-quoted value")
        return value[1:-1].replace("''", "'")
    if value.startswith('"'):
        try:
            parsed = ast.literal_eval(value)
        except (SyntaxError, ValueError) as exc:
            raise ValueError(f"invalid double-quoted value: {exc}") from exc
        if not isinstance(parsed, str):
            raise ValueError("double-quoted value is not a string")
        return parsed
    return value


root = Path(os.environ["ROOT_DIR"])
errors = []

seen_names = {}

skill_paths = []
for dirpath, dirnames, filenames in os.walk(root / "skills", followlinks=True):
    dirnames.sort()
    if "SKILL.md" in filenames:
        skill_paths.append(Path(dirpath) / "SKILL.md")

for path in sorted(skill_paths):
    lines = path.read_text().splitlines()
    if not lines or lines[0] != "---":
        errors.append(f"missing frontmatter: {path}")
        continue

    try:
        end = lines[1:].index("---") + 1
    except ValueError:
        errors.append(f"unterminated frontmatter: {path}")
        continue

    metadata = {}
    for line in lines[1:end]:
        if not line.strip():
            continue
        if ":" not in line:
            errors.append(f"invalid frontmatter line: {path}: {line!r}")
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        if not key:
            errors.append(f"empty frontmatter key: {path}: {line!r}")
            continue
        try:
            metadata[key] = parse_scalar(raw_value)
        except ValueError as exc:
            errors.append(f"invalid frontmatter value: {path}: {key}: {exc}")

    expected_name = path.parent.name
    if metadata.get("name") != expected_name:
        errors.append(f"name mismatch: {path}: {metadata.get('name')!r}")
    if not metadata.get("description"):
        errors.append(f"missing description: {path}")
    openai_metadata = path.parent / "agents" / "openai.yaml"
    if not openai_metadata.is_file():
        errors.append(f"missing Codex metadata: {openai_metadata}")
    name = metadata.get("name")
    if name:
        if name == "impeccable":
            errors.append(f"retired skill must not be reintroduced: {path}")
        previous = seen_names.get(name)
        if previous is not None:
            errors.append(f"duplicate skill name: {name}: {previous} and {path}")
        seen_names[name] = path

    if not path.is_symlink():
        errors.append(f"root SKILL.md must select the default variant by symlink: {path}")
    elif os.readlink(path) != "variants/gpt-5.6.md":
        errors.append(f"unexpected default variant link: {path}: {os.readlink(path)!r}")

    for profile in ("gpt-5.6", "gpt-6-astra", "claude-fable-5.1", "claude-opus-5"):
        variant = path.parent / "variants" / f"{profile}.md"
        if not variant.is_file():
            errors.append(f"missing model variant: {variant}")
            continue
        variant_lines = variant.read_text().splitlines()
        if not variant_lines or variant_lines[0] != "---":
            errors.append(f"missing variant frontmatter: {variant}")
            continue
        try:
            variant_end = variant_lines[1:].index("---") + 1
        except ValueError:
            errors.append(f"unterminated variant frontmatter: {variant}")
            continue
        if not any(line.strip() for line in variant_lines[variant_end + 1 :]):
            errors.append(f"empty model variant body: {variant}")
        variant_name = None
        variant_description = None
        for line in variant_lines[1:variant_end]:
            if line.startswith("name:"):
                variant_name = parse_scalar(line.split(":", 1)[1])
            if line.startswith("description:"):
                variant_description = parse_scalar(line.split(":", 1)[1])
        if variant_name != name:
            errors.append(f"variant name mismatch: {variant}: {variant_name!r}")
        if variant_description != metadata.get("description"):
            errors.append(f"variant description mismatch: {variant}")

old_writing_skill = root / "skills/writing-great-skills"
if old_writing_skill.exists():
    errors.append(f"retired writing skill still exists: {old_writing_skill}")

writing_metadata = root / "skills/writing-for-agents/agents/openai.yaml"
if "allow_implicit_invocation: false" in writing_metadata.read_text():
    errors.append("writing-for-agents must remain model-invoked")

if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
PY
}

test_upstream_manifest_is_valid() {
  ROOT_DIR="$ROOT_DIR" python3 <<'PY'
from datetime import date
import json
import os
from pathlib import Path, PurePosixPath
import re


root = Path(os.environ["ROOT_DIR"])
manifest_path = root / "upstreams.json"
manifest = json.loads(manifest_path.read_text())

if manifest.get("schemaVersion") != 1:
    raise SystemExit("upstreams.json must use schemaVersion 1")

try:
    date.fromisoformat(manifest["reviewedAt"])
except (KeyError, TypeError, ValueError) as exc:
    raise SystemExit("upstreams.json reviewedAt must be an ISO date") from exc

if "external.md" not in manifest.get("scope", ""):
    raise SystemExit("upstreams.json must keep installer-owned pins in external.md")

repositories = set()

sources = manifest.get("sources")
if not isinstance(sources, list) or not sources:
    raise SystemExit("upstreams.json must track at least one source")

for source in sources:
    repository = source.get("repository", "")
    if not repository.startswith("https://github.com/"):
        raise SystemExit(f"invalid upstream repository: {repository!r}")
    if repository in repositories:
        raise SystemExit(f"duplicate upstream repository: {repository}")
    repositories.add(repository)

    commit = source.get("reviewedCommit", "")
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise SystemExit(f"invalid reviewed commit for {repository}: {commit!r}")

    mappings = source.get("mappings")
    if not isinstance(mappings, list) or not mappings:
        raise SystemExit(f"missing skill mappings for {repository}")

    for mapping in mappings:
        local_skill = mapping.get("localSkill", "")
        if not (root / "skills" / local_skill / "SKILL.md").is_file():
            raise SystemExit(f"tracked local skill does not exist: {local_skill!r}")
        if mapping.get("relationship") not in {"adapted", "inspired"}:
            raise SystemExit(f"invalid relationship for {local_skill!r}")
        upstream_paths = mapping.get("upstreamPaths")
        if not isinstance(upstream_paths, list) or not upstream_paths:
            raise SystemExit(f"missing upstream paths for {local_skill!r}")
        for upstream_path in upstream_paths:
            path = PurePosixPath(upstream_path)
            if path.is_absolute() or ".." in path.parts:
                raise SystemExit(
                    f"invalid upstream path for {local_skill!r}: {upstream_path!r}"
                )

PY
}

test_findings_reviewer_config_only_filters_workflow_skills() {
  ROOT_DIR="$ROOT_DIR" bun --eval '
import assert from "node:assert/strict";

const { default: config } = await import(`${process.env.ROOT_DIR}/codex/findings-reviewer.config.toml`);
assert.deepEqual(new Set(Object.keys(config)), new Set(["model", "review_model", "model_reasoning_effort", "developer_instructions", "skills"]));
assert.equal(config.model, "gpt-6-astra");
assert.equal(config.review_model, "gpt-6-astra");
assert.equal(config.model_reasoning_effort, "medium");
assert.equal(typeof config.developer_instructions, "string");
assert.ok(config.developer_instructions.trim());
assert.deepEqual(Object.keys(config.skills), ["config"]);
const exclusions = config.skills.config;
assert.ok(Array.isArray(exclusions));
for (const entry of exclusions) {
  assert.deepEqual(new Set(Object.keys(entry)), new Set(["name", "enabled"]));
  assert.equal(typeof entry.name, "string");
  assert.ok(entry.name.length > 0);
  assert.equal(entry.enabled, false);
}
const names = new Set(exclusions.map(entry => entry.name));
assert.equal(names.size, exclusions.length);
for (const name of [
  "code-review", "review-until-clean", "cold-pr-review-until-clean",
  "just-do-it", "handoff", "pr-proof-pack",
]) assert.ok(names.has(name), `${name} must be excluded`);
for (const name of [
  "cold-pr-review", "finding-discipline", "review-guardrails",
  "review-flow-map", "test-audit", "reducing-cognitive-load",
  "typescript-discipline", "mcp-server-review", "improve-codebase-architecture",
]) assert.ok(!names.has(name), `${name} must remain available`);
'
}

