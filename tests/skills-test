  assert_output_contains "$explicit_net_diff" '"sha": '"\"$destination_sha\""
  assert_output_contains "$explicit_net_diff" '"comparisonBase": '"\"$base_sha\""
  assert_output_contains "$explicit_net_diff" '"head": '"\"$selected_sha\""
