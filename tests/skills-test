test_agent_aquarium_provider_snapshot_is_bounded() {
  local tmp snapshotter output
  tmp="$(mktemp -d)"
  snapshotter="$ROOT_DIR/skills/agent-aquarium/agent-aquarium-local-test/scripts/snapshot-provider-state.py"
  mkdir -p "$tmp/codex/sessions/2026/08/10" "$tmp/claude/projects/demo"

  TEST_ROOT="$tmp" python3 <<'PY'
from pathlib import Path
import os

root = Path(os.environ["TEST_ROOT"])
files = [
    (root / "codex/sessions/2026/08/10/old.jsonl", "old", 1),
    (root / "codex/sessions/2026/08/10/new.jsonl", "new", 2),
    (root / "claude/projects/demo/old.jsonl", "old", 1),
    (root / "claude/projects/demo/new.jsonl", "new", 2),
]
for path, content, modified in files:
    path.write_text(content)
    os.utime(path, (modified, modified))
PY

  output="$(
    python3 "$snapshotter" \
      --codex-home "$tmp/codex" \
      --claude-config-dir "$tmp/claude" \
      --destination "$tmp/snapshot" \
      --max-files 1 \
      --max-bytes 100
  )"

  assert_output_contains "$output" '"copiedFiles": 1'
  test -f "$tmp/snapshot/codex/sessions/2026/08/10/new.jsonl" \
    || fail "newest Codex session should be copied"
  test "$(python3 -c 'from pathlib import Path; import stat, sys; print(oct(stat.S_IMODE(Path(sys.argv[1]).stat().st_mode)))' \
    "$tmp/snapshot/codex/sessions/2026/08/10/new.jsonl")" = 0o600 \
    || fail "copied provider sessions should be owner-readable only"
  test ! -e "$tmp/snapshot/codex/sessions/2026/08/10/old.jsonl" \
    || fail "older Codex session should be excluded by the file budget"
  test -f "$tmp/snapshot/claude/projects/demo/new.jsonl" \
    || fail "newest Claude session should be copied"
  test ! -e "$tmp/snapshot/claude/projects/demo/old.jsonl" \
    || fail "older Claude session should be excluded by the file budget"
}

