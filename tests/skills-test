  assert_output_not_contains "$explicit_net_diff" '"path": "destination.txt"'
  assert_output_not_contains "$explicit_net_diff" '"path": "observer.txt"'
  assert_output_contains "$explicit_net_diff" 'Add selected change'
  assert_output_contains "$explicit_net_diff" '"transient.txt"'
  assert_output_not_contains "$explicit_net_diff" 'Advance observer'
