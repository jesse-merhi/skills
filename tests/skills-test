#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

suites="$(git ls-files --cached --others --exclude-standard packages skills)"
while IFS= read -r suite; do
  if [[ "$suite" == *.test.mjs && -f "$suite" ]]; then
    node --test "$suite"
  fi
done < <(LC_ALL=C sort <<< "$suites")

python3 -m unittest discover -s skills/openclaw/openclaw-stg-test/scripts -p 'test_*.py' --failfast
