test_handoff_tmux_helper_builds_tmux_window_command() {
  local tmp handoff output helper
  tmp="$(mktemp -d)"
  handoff="$tmp/handoff.md"
  printf '# Handoff\n' > "$handoff"

  helper="$ROOT_DIR/skills/handoff/scripts/codex-handoff-tmux"

  output="$(
    TMUX=/tmp/fake \
      "$helper" \
        --file "$handoff" \
        --focus "next thing" \
        --cd "$ROOT_DIR" \
        --relationship aside \
        --dry-run
  )"

  assert_output_contains "$output" "tmux new-window -c"
  assert_output_contains "$output" "-n handoff"
  assert_output_contains "$output" "codex-handoff-tmux"
  assert_output_not_contains "$output" "--focus  --cd"
  assert_output_contains "$output" "--run-codex"
  assert_output_contains "$output" "--file"
  assert_output_contains "$output" "--focus"
  assert_output_contains "$output" "--mode"
  assert_output_contains "$output" "new"

  output="$(
    TMUX=/tmp/fake \
      "$helper" \
        --file "$handoff" \
        --focus $'one\ntwo' \
        --cd "$ROOT_DIR" \
        --relationship aside \
        --dry-run
  )"
  assert_output_contains "$output" $'one\ntwo'

  output="$(
    TMUX=/tmp/fake \
      "$helper" \
        --file "$handoff" \
        --cd "$ROOT_DIR" \
        --relationship aside \
        --dry-run
  )"

  assert_output_contains "$output" "--file"
  assert_output_contains "$output" "--cd"
  assert_output_not_contains "$output" "--focus"

  output="$(
    TMUX=/tmp/fake \
      TMUX_PANE=%123 \
      "$helper" \
        --file "$handoff" \
        --focus "next thing" \
        --cd "$ROOT_DIR" \
        --relationship continuation \
        --dry-run
  )"

  assert_output_contains "$output" "tmux split-window -h -c"
  assert_output_contains "$output" "-t %123"
  assert_output_contains "$output" "codex-handoff-tmux"
  assert_output_contains "$output" "--run-codex"
  assert_output_contains "$output" "--file"
  assert_output_contains "$output" "--focus"

  output="$(
    env -u TMUX_PANE \
      TMUX=/tmp/fake \
      "$helper" \
        --file "$handoff" \
        --focus "next thing" \
        --cd "$ROOT_DIR" \
        --relationship continuation \
        --tmux-target "0:9" \
        --dry-run
  )"

  assert_output_contains "$output" "tmux split-window -h -c"
  assert_output_contains "$output" "-t 0:9"

  if env -u TMUX_PANE \
      TMUX=/tmp/fake \
      "$helper" \
        --file "$handoff" \
        --focus "next thing" \
        --cd "$ROOT_DIR" \
        --relationship continuation \
        --dry-run >"$tmp/missing-target.out" 2>&1; then
    fail "pane placement should require TMUX_PANE or --tmux-target"
  fi

  assert_contains "$tmp/missing-target.out" "A continuation handoff requires TMUX_PANE or --tmux-target"
  "$ROOT_DIR/skills/handoff/scripts/detect-handoff-surface.test.sh"

  output="$(
    env -u TMUX \
      "$helper" \
        --file "$handoff" \
        --focus "next thing" \
        --cd "$ROOT_DIR"
  )"

  assert_output_contains "$output" "No tmux session detected"
  assert_output_contains "$output" "$handoff"

  if env -u TMUX \
      "$helper" \
        --file "$tmp" \
        --cd "$ROOT_DIR" >"$tmp/directory-handoff.out" 2>&1; then
    fail "a directory must not be accepted as a handoff file"
  fi
  assert_contains "$tmp/directory-handoff.out" "Handoff path is not a file"

  if env -u TMUX \
      "$helper" \
        --file "$handoff" \
        --cd "$handoff" >"$tmp/file-workdir.out" 2>&1; then
    fail "a file must not be accepted as a working directory"
  fi
  assert_contains "$tmp/file-workdir.out" "Working path is not a directory"

  mkdir "$tmp/not-a-worktree"
  if env -u TMUX \
      "$helper" \
        --file "$handoff" \
        --cd "$ROOT_DIR" \
        --worktree "$tmp/not-a-worktree" >"$tmp/not-worktree.out" 2>&1; then
    fail "an existing non-git path must not be reused as a handoff worktree"
  fi
  assert_contains "$tmp/not-worktree.out" "Worktree path exists but is not a git worktree"

  mkdir "$tmp/fake-bin"
  printf '%s\n' '#!/usr/bin/env bash' 'printf "fake-codex: %s\\n" "$*"' > "$tmp/fake-bin/codex"
  chmod +x "$tmp/fake-bin/codex"
  output="$(
    PATH="$tmp/fake-bin:$PATH" \
      "$helper" \
        --run-codex \
        --file "$handoff" \
        --cd "$ROOT_DIR"
  )"
  assert_output_contains "$output" "fake-codex: --cd $ROOT_DIR"
  assert_output_contains "$output" "Read the handoff document before acting"
}

test_pr_proof_helpers() {
  local skill="$ROOT_DIR/skills/pr-proof-pack"
  local base_sha destination_sha explicit_markdown explicit_net_diff fake_gh_dir invalid_stdout net_diff_fixture net_diff_help observer_sha rendered_help requested_net_diff selected_sha unrelated_sha unrelated_tree wizard_output

  if [[ ! -x "$skill/scripts/github-verify-rendered-proof" ]]; then
    fail "expected github-verify-rendered-proof wrapper to be executable"
  fi
  rendered_help="$("$skill/scripts/github-verify-rendered-proof" --help)"
  assert_output_contains "$rendered_help" "--pr"
  assert_output_contains "$rendered_help" "--head"
  assert_output_contains "$rendered_help" "without printing signed URLs"
  net_diff_help="$("$skill/scripts/pr-net-diff" --help)"
  assert_output_contains "$net_diff_help" "--base"
  assert_output_contains "$net_diff_help" "--head"
  wizard_output="$("$skill/scripts/pr-net-diff" --json --wizard </dev/null)"
  assert_output_contains "$wizard_output" 'Command wizard'
  assert_output_contains "$wizard_output" 'Current command'
  assert_output_not_contains "$wizard_output" '"base": {'
  net_diff_fixture="$(mktemp -d)"
  git -C "$net_diff_fixture" init -q -b main
  git -C "$net_diff_fixture" config user.name "Skills Test"
  git -C "$net_diff_fixture" config user.email "skills-test@example.com"
  printf 'base\n' > "$net_diff_fixture/base.txt"
  git -C "$net_diff_fixture" add base.txt && git -C "$net_diff_fixture" commit -qm "Add base"
  base_sha="$(git -C "$net_diff_fixture" rev-parse HEAD)"
  printf 'destination\n' > "$net_diff_fixture/destination.txt"
  git -C "$net_diff_fixture" add destination.txt && git -C "$net_diff_fixture" commit -qm "Advance destination"
  destination_sha="$(git -C "$net_diff_fixture" rev-parse HEAD)"
  git -C "$net_diff_fixture" checkout -qb source "$base_sha"
  printf 'selected\n' > "$net_diff_fixture/feature.txt"
  git -C "$net_diff_fixture" add feature.txt && git -C "$net_diff_fixture" commit -qm "Add selected change"
  printf 'transient\n' > "$net_diff_fixture/transient.txt"
  git -C "$net_diff_fixture" add transient.txt && git -C "$net_diff_fixture" commit -qm "Add transient change"
  git -C "$net_diff_fixture" rm -q transient.txt && git -C "$net_diff_fixture" commit -qm "Revert transient change"
  selected_sha="$(git -C "$net_diff_fixture" rev-parse HEAD)"
  git -C "$net_diff_fixture" checkout -qb observer "$base_sha"
  printf 'observer\n' > "$net_diff_fixture/observer.txt"
  git -C "$net_diff_fixture" add observer.txt && git -C "$net_diff_fixture" commit -qm "Advance observer"
  observer_sha="$(git -C "$net_diff_fixture" rev-parse HEAD)"
  explicit_net_diff="$(cd "$net_diff_fixture" && "$skill/scripts/pr-net-diff" --base "$destination_sha" --head "$selected_sha" --json)"
