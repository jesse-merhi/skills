#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  codex-handoff-tmux --file HANDOFF.md [--focus TEXT] [--cd DIR] [--mode new|fork-last] [--window-name NAME] [--pane] [--tmux-target TARGET]
                     [--worktree PATH | --worktree-name NAME] [--branch BRANCH] [--base REF]

Open a tmux window or targeted pane for a Codex handoff when the current process
is running inside tmux. Outside tmux, leave the handoff file in place and print
a note.

Options:
  --file PATH        Handoff document the new Codex session should read.
  --focus TEXT      Short description of the next session's work.
  --cd DIR          Working directory for Codex. Defaults to the current directory.
  --mode MODE       new, or fork-last. Defaults to new.
  --window-name     tmux window name. Defaults to handoff.
  --pane            Split a tmux pane instead of opening a new window.
  --tmux-target     tmux pane/window/session target. Defaults to TMUX_PANE.
  --worktree PATH   Create or reuse this git worktree and run Codex there.
  --worktree-name   Create or reuse a sibling worktree with this directory name.
  --branch BRANCH   Branch to create/use for the worktree. Defaults to work/<worktree-name>.
  --base REF        Base ref for a newly-created worktree branch. Defaults to HEAD.
  --dry-run         Print the tmux command instead of running it.
  -h, --help        Show this help.
EOF
}

quote_arg() {
  printf '%q' "$1"
}

script_path() {
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  printf '%s/%s' "$dir" "$(basename "${BASH_SOURCE[0]}")"
}

build_prompt() {
  printf 'Read the handoff document before acting:\n\n%s\n\n' "$HANDOFF_FILE"

  if [[ -n "$FOCUS" ]]; then
    printf 'Next session focus:\n\n%s\n\n' "$FOCUS"
  fi

  printf 'Working directory:\n\n%s\n\n' "$WORKDIR"

  if [[ "$WORKTREE_REQUESTED" -eq 1 ]]; then
    printf 'This directory was prepared as this worker'\''s dedicated git worktree. Do not use the coordinator worktree for implementation.\n\n'
  fi

  printf 'Start by reading the handoff, then continue from it. Keep the final reply short and report what you did.'
}

run_codex() {
  local prompt
  prompt="$(build_prompt)"

  cd "$WORKDIR"

  case "$MODE" in
    new)
      exec codex --cd "$WORKDIR" "$prompt"
      ;;
    fork-last)
      exec codex fork --last --cd "$WORKDIR" "$prompt"
      ;;
    *)
      printf 'Unsupported mode: %s\n' "$MODE" >&2
      exit 2
      ;;
  esac
}

sanitize_branch_part() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

resolve_requested_worktree() {
  [[ "$WORKTREE_REQUESTED" -eq 1 ]] || return 0

  if ! command -v git >/dev/null 2>&1; then
    printf 'Cannot resolve worktree because git is not available on PATH.\n' >&2
    exit 1
  fi

  local repo_top worktree_path worktree_name
  repo_top="$(git -C "$WORKDIR" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$repo_top" ]]; then
    printf 'Cannot resolve worktree because --cd is not inside a git repository: %s\n' "$WORKDIR" >&2
    exit 1
  fi

  if [[ -n "$WORKTREE_PATH" && -n "$WORKTREE_NAME" ]]; then
    printf '%s\n' 'Use only one of --worktree or --worktree-name.' >&2
    exit 2
  fi

  if [[ -n "$WORKTREE_PATH" ]]; then
    worktree_path="$WORKTREE_PATH"
    worktree_name="$(basename "$WORKTREE_PATH")"
  else
    worktree_name="$WORKTREE_NAME"
    worktree_path="$(dirname "$repo_top")/$worktree_name"
  fi

  if [[ -z "$worktree_name" || "$worktree_name" == "." || "$worktree_name" == "/" ]]; then
    printf 'Invalid worktree name/path: %s%s\n' "$WORKTREE_NAME" "$WORKTREE_PATH" >&2
    exit 2
  fi

  RESOLVED_WORKTREE_PATH="$worktree_path"
  RESOLVED_WORKTREE_NAME="$worktree_name"
  RESOLVED_REPO_TOP="$repo_top"
}

prepare_worktree() {
  [[ "$WORKTREE_REQUESTED" -eq 1 ]] || return 0

  resolve_requested_worktree

  local worktree_path worktree_name branch base_ref repo_top
  worktree_path="$RESOLVED_WORKTREE_PATH"
  worktree_name="$RESOLVED_WORKTREE_NAME"
  repo_top="$RESOLVED_REPO_TOP"

  branch="$WORKTREE_BRANCH"
  if [[ -z "$branch" ]]; then
    branch="work/$(sanitize_branch_part "$worktree_name")"
  fi

  base_ref="${WORKTREE_BASE:-HEAD}"

  if [[ -e "$worktree_path" ]]; then
    if git -C "$worktree_path" rev-parse --show-toplevel >/dev/null 2>&1; then
      WORKDIR="$(git -C "$worktree_path" rev-parse --show-toplevel)"
      printf 'Using existing git worktree: %s\n' "$WORKDIR"
      return 0
    fi

    printf 'Worktree path exists but is not a git worktree: %s\n' "$worktree_path" >&2
    exit 1
  fi

  if git -C "$repo_top" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_top" worktree add "$worktree_path" "$branch"
  else
    git -C "$repo_top" worktree add -b "$branch" "$worktree_path" "$base_ref"
  fi

  WORKDIR="$worktree_path"
  printf 'Created git worktree %s on branch %s from %s\n' "$WORKDIR" "$branch" "$base_ref"
}

HANDOFF_FILE=""
FOCUS=""
WORKDIR="$PWD"
MODE="new"
WINDOW_NAME="handoff"
DRY_RUN=0
RUN_CODEX=0
PANE=0
TMUX_TARGET="${TMUX_PANE:-}"
WORKTREE_REQUESTED=0
WORKTREE_PATH=""
WORKTREE_NAME=""
WORKTREE_BRANCH=""
WORKTREE_BASE=""
RESOLVED_WORKTREE_PATH=""
RESOLVED_WORKTREE_NAME=""
RESOLVED_REPO_TOP=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --file)
      HANDOFF_FILE="${2:-}"
      shift 2
      ;;
    --focus)
      FOCUS="${2:-}"
      shift 2
      ;;
    --cd)
      WORKDIR="${2:-}"
      shift 2
      ;;
    --mode)
      MODE="${2:-}"
      shift 2
      ;;
    --window-name)
      WINDOW_NAME="${2:-}"
      shift 2
      ;;
    --pane)
      PANE=1
      shift
      ;;
    --tmux-target)
      TMUX_TARGET="${2:-}"
      shift 2
      ;;
    --worktree)
      WORKTREE_REQUESTED=1
      WORKTREE_PATH="${2:-}"
      shift 2
      ;;
    --worktree-name)
      WORKTREE_REQUESTED=1
      WORKTREE_NAME="${2:-}"
      shift 2
      ;;
    --branch)
      WORKTREE_BRANCH="${2:-}"
      shift 2
      ;;
    --base)
      WORKTREE_BASE="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --run-codex)
      RUN_CODEX=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$HANDOFF_FILE" ]]; then
  printf '%s\n' '--file is required' >&2
  usage >&2
  exit 2
fi

if [[ "$MODE" != "new" && "$MODE" != "fork-last" ]]; then
  printf '%s\n' '--mode must be new or fork-last' >&2
  exit 2
fi

if [[ ! -f "$HANDOFF_FILE" ]]; then
  printf 'Handoff file does not exist: %s\n' "$HANDOFF_FILE" >&2
  exit 1
fi

if [[ ! -d "$WORKDIR" ]]; then
  printf 'Working directory does not exist: %s\n' "$WORKDIR" >&2
  exit 1
fi

if [[ "$DRY_RUN" -eq 0 ]]; then
  prepare_worktree
elif [[ "$WORKTREE_REQUESTED" -eq 1 ]]; then
  resolve_requested_worktree
  WORKDIR="$RESOLVED_WORKTREE_PATH"
  printf 'Dry run: would prepare dedicated worktree before launching Codex: %s\n' "$WORKDIR"
fi

if [[ "$RUN_CODEX" -eq 1 ]]; then
  run_codex
fi

if [[ -z "${TMUX:-}" ]]; then
  printf 'No tmux session detected; handoff file is ready: %s\n' "$HANDOFF_FILE"
  exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf 'TMUX is set, but tmux is not available on PATH.\n' >&2
  exit 1
fi

if [[ "$PANE" -eq 1 && -z "$TMUX_TARGET" ]]; then
  printf '%s\n' 'Pane placement requires TMUX_PANE or --tmux-target.' >&2
  exit 1
fi

helper="$(script_path)"
command_parts=(
  "$helper"
  "--run-codex"
  "--file" "$HANDOFF_FILE"
  "--focus" "$FOCUS"
  "--cd" "$WORKDIR"
  "--mode" "$MODE"
)

if [[ "$WORKTREE_REQUESTED" -eq 1 ]]; then
  command_parts+=("--worktree" "$WORKDIR")
fi

tmux_command=""
for part in "${command_parts[@]}"; do
  if [[ -n "$tmux_command" ]]; then
    tmux_command+=" "
  fi
  tmux_command+="$(quote_arg "$part")"
done

if [[ "$DRY_RUN" -eq 1 ]]; then
  if [[ "$PANE" -eq 1 ]]; then
    printf 'tmux split-window -h -c %s -t %s %s\n' "$(quote_arg "$WORKDIR")" "$(quote_arg "$TMUX_TARGET")" "$(quote_arg "$tmux_command")"
  else
    printf 'tmux new-window -c %s -n %s %s\n' "$(quote_arg "$WORKDIR")" "$(quote_arg "$WINDOW_NAME")" "$(quote_arg "$tmux_command")"
  fi
  exit 0
fi

if [[ "$PANE" -eq 1 ]]; then
  tmux split-window -h -c "$WORKDIR" -t "$TMUX_TARGET" "$tmux_command"
  printf 'Opened tmux pane with Codex handoff: %s\n' "$HANDOFF_FILE"
else
  tmux new-window -c "$WORKDIR" -n "$WINDOW_NAME" "$tmux_command"
  printf 'Opened tmux window %s with Codex handoff: %s\n' "$WINDOW_NAME" "$HANDOFF_FILE"
fi
