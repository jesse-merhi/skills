#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
if [[ "$mode" != "read" && "$mode" != "write" ]]; then
  echo "usage: ask-codex read|write <prompt>" >&2
  exit 64
fi
shift
if [[ $# -eq 0 ]]; then
  echo "ask-codex: prompt is required" >&2
  exit 64
fi

timeout_seconds="${ASK_AGENT_TIMEOUT_SECONDS:-1800}"
permissions=(--approve-reads --non-interactive-permissions fail)
if [[ "$mode" == "write" ]]; then
  permissions=(--approve-all)
fi

# Resolve the latest acpx and Codex adapter on every run, so new Codex models work without a pin bump.
# acpx's built-in codex agent pins an older adapter whose bundled Codex CLI rejects current models.
codex_adapter="npx -y @agentclientprotocol/codex-acp@latest"
# Replace the actual ACP process so cancellation does not stop at an npx parent.
acpx_executable="$(npx --yes --package=acpx@latest --call 'command -v acpx')"
exec "$acpx_executable" \
  --cwd "$PWD" \
  "${permissions[@]}" \
  --timeout "$timeout_seconds" \
  --agent "$codex_adapter" \
  exec "$@"
