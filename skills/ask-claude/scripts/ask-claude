#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
if [[ "$mode" != "read" && "$mode" != "write" ]]; then
  echo "usage: ask-claude read|write <prompt>" >&2
  exit 64
fi
shift
if [[ $# -eq 0 ]]; then
  echo "ask-claude: prompt is required" >&2
  exit 64
fi

timeout_seconds="${ASK_AGENT_TIMEOUT_SECONDS:-1800}"
permissions=(--approve-reads --non-interactive-permissions fail)
if [[ "$mode" == "write" ]]; then
  permissions=(--approve-all)
fi

# Replace the actual ACP process so cancellation does not stop at an npx parent.
acpx_executable="$(npx --yes --package=acpx@0.13.1 --call 'command -v acpx')"
export CLAUDE_CODE_SKIP_PROMPT_HISTORY=1
exec "$acpx_executable" \
  --cwd "$PWD" \
  "${permissions[@]}" \
  --timeout "$timeout_seconds" \
  claude exec "$@"
