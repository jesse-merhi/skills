{
	"version": 1,
	"ecosystems": {
		"javascript": {
			"detect": [
				"package.json"
			],
			"packages": {
				"eslint": "9.39.2"
			},
			"presets": "javascript"
		},
		"python": {
			"detect": [
				"pyproject.toml"
			],
			"presets": "python"
		}
	},
	"presets": {
		"javascript": {
			"base": {
				"file": "eslint/presets/base.mjs",
				"packages": {
					"eslint-import-resolver-typescript": "3.10.1",
					"eslint-plugin-import-x": "4.17.0",
					"eslint-plugin-perfectionist": "5.9.1",
					"eslint-plugin-promise": "7.3.0",
					"eslint-plugin-sonarjs": "4.1.0"
				},
				"applies": {
					"always": true
				}
			},
			"typescript": {
				"file": "eslint/presets/typescript.mjs",
				"packages": {
					"@typescript-eslint/eslint-plugin": "8.60.1",
					"@typescript-eslint/parser": "8.60.1"
				},
				"applies": {
					"devDependencies": [
						"typescript"
					]
				}
			},
			"react": {
				"file": "eslint/presets/react.mjs",
				"packages": {
					"eslint-plugin-jsx-a11y": "6.10.2",
					"eslint-plugin-react-hooks": "7.1.1",
					"eslint-plugin-react-refresh": "0.4.19",
					"eslint-plugin-react-you-might-not-need-an-effect": "1.0.1"
				},
				"applies": {
					"dependencies": [
						"react"
					]
				}
			},
			"react-native": {
				"file": "eslint/presets/react-native.mjs",
				"packages": {
					"eslint-plugin-react-native-a11y": "3.5.1"
				},
				"applies": {
					"dependencies": [
						"react-native"
					]
				}
			},
			"tailwind": {
				"file": "eslint/presets/tailwind.mjs",
				"packages": {},
				"applies": {
					"devDependencies": [
						"tailwindcss"
					]
				}
			},
			"zod": {
				"file": "eslint/presets/zod.mjs",
				"packages": {},
				"applies": {
					"dependencies": [
						"zod"
					]
				}
			},
			"tanstack-query": {
				"file": "eslint/presets/tanstack-query.mjs",
				"packages": {
					"@tanstack/eslint-plugin-query": "5.101.1"
				},
				"applies": {
					"dependencies": [
						"@tanstack/react-query"
					]
				}
			},
			"prisma": {
				"file": "eslint/presets/prisma.mjs",
				"packages": {},
				"applies": {
					"dependencies": [
						"@prisma/client"
					]
				}
			},
			"vitest": {
				"file": "eslint/presets/vitest.mjs",
				"packages": {
					"@vitest/eslint-plugin": "1.6.20"
				},
				"applies": {
					"devDependencies": [
						"vitest"
					]
				}
			},
			"jest": {
				"file": "eslint/presets/jest.mjs",
				"packages": {
					"eslint-plugin-jest": "29.15.4"
				},
				"applies": {
					"devDependencies": [
						"jest"
					]
				}
			},
			"playwright": {
				"file": "eslint/presets/playwright.mjs",
				"packages": {
					"eslint-plugin-playwright": "2.10.4"
				},
				"applies": {
					"devDependencies": [
						"@playwright/test"
					]
				}
			}
		},
		"python": {
			"ruff": {
				"file": "python/ruff.toml",
				"packages": {
					"ruff": "0.16.5"
				},
				"applies": {
					"always": true
				}
			},
			"mypy": {
				"file": "python/mypy.ini",
				"packages": {
					"mypy": "2.3.1"
				},
				"applies": {
					"always": true
				}
			},
			"semgrep": {
				"file": "python/semgrep",
				"packages": {
					"semgrep": "1.173.0"
				},
				"applies": {
					"always": true
				}
			},
			"checks": {
				"file": "python/standards_checks",
				"packages": {},
				"applies": {
					"always": true
				}
			}
		}
	},
	"baselines": {
		"prettier": {
			"file": "prettier/prettierrc.json",
			"target": ".prettierrc.json",
			"applies": {
				"devDependencies": [
					"prettier"
				]
			}
		},
		"tsconfig-strict": {
			"file": "tsconfig/strict.base.json",
			"target": "lint/standards/tsconfig.strict.json",
			"applies": {
				"devDependencies": [
					"typescript"
				]
			}
		},
		"react-doctor": {
			"file": "react-doctor/doctor.config.json",
			"target": "doctor.config.json",
			"applies": {
				"devDependencies": [
					"react-doctor"
				]
			}
		}
	},
	"standards": [
		{
			"id": "no-banner-comments",
			"title": "No decorative comment separators",
			"principle": "A comment should say something. Rows of dashes or equals signs only add noise and go stale when the code around them moves. Write a plain one-line section comment, or nothing.",
			"scope": "any",
			"origin": "uplinked eslint-rules/no-banner-comments.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-banner-comments.mjs",
						"presets": [
							"base"
						]
					}
				],
				"script": [
					{
						"kind": "script",
						"file": "scripts/no-banner-comments.sh",
						"languages": [
							"yaml",
							"sh"
						]
					}
				],
				"python": [
					{
						"kind": "check",
						"module": "standards_checks.no_banner_comments",
						"file": "python/standards_checks/no_banner_comments.py"
					}
				]
			}
		},
		{
			"id": "no-trivial-forwarding-wrapper",
			"title": "No pass-through wrappers",
			"principle": "A helper whose whole body is `return other(sameArgs)` adds a name and a hop without adding meaning. Call the underlying function directly. Keep a wrapper only when it captures a concept, enforces an invariant, marks a boundary, or exists as a test seam.",
			"scope": "any",
			"origin": "uplinked eslint-rules/no-trivial-forwarding-wrapper.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-trivial-forwarding-wrapper.mjs",
						"presets": [
							"base"
						]
					}
				],
				"python": [
					{
						"kind": "check",
						"module": "standards_checks.no_trivial_forwarding_wrapper",
						"file": "python/standards_checks/no_trivial_forwarding_wrapper.py"
					}
				]
			}
		},
		{
			"id": "no-large-test-snapshots",
			"title": "No broad snapshots in ordinary tests",
			"principle": "A whole-output snapshot fails on every unrelated change and gets re-recorded without being read, so it stops proving anything. Assert the specific fields or behaviour the test is about, and keep deliberate serializer coverage in files named for it.",
			"scope": "tests",
			"origin": "uplinked eslint-rules/no-large-test-snapshots.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-large-test-snapshots.mjs",
						"presets": [
							"vitest",
							"jest",
							"playwright"
						]
					}
				],
				"python": [
					{
						"kind": "check",
						"module": "standards_checks.no_large_test_snapshots",
						"file": "python/standards_checks/no_large_test_snapshots.py"
					}
				]
			}
		},
		{
			"id": "no-broad-rule-disable",
			"title": "No blanket disables of protected rules",
			"principle": "A file- or block-level disable silently turns a rule off for everything below it, including code written later. Disable a protected rule on the single line that needs the exception, so the next reader sees exactly what was excused and why. A bare eslint-disable with no rule name is invisible to ESLint itself, so pair this rule with a repository-wide grep for it.",
			"scope": "any",
			"origin": "uplinked eslint-rules/no-zod-type-any-block-disable.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-broad-rule-disable.mjs",
						"presets": [
							"zod"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"PGH003",
							"PGH004"
						]
					}
				]
			}
		},
		{
			"id": "no-raw-sql",
			"title": "No raw SQL escape hatches",
			"principle": "Query-builder escape hatches such as `Prisma.raw` hand a string straight to the database, so any interpolated value becomes injectable. Use parameterised queries or the builder's typed API instead.",
			"scope": "prisma",
			"origin": "uplinked eslint-rules/no-prisma-raw.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-raw-sql.mjs",
						"presets": [
							"prisma"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"S608"
						]
					},
					{
						"kind": "semgrep",
						"file": "python/semgrep/no-raw-sql-orm-escape.yaml"
					}
				]
			}
		},
		{
			"id": "no-raw-color-literals",
			"title": "No raw color literals in color props",
			"principle": "A hex or rgb() literal in a color prop bypasses the theme, so it cannot follow light and dark mode or a palette change. Use a theme token.",
			"scope": "react-native",
			"origin": "uplinked eslint-rules/mobile-raw-color-selectors.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-raw-color-literals.mjs",
						"presets": [
							"react-native"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Colour literals belong to stylesheets and design tokens, not Python source."
					}
				]
			}
		},
		{
			"id": "no-zod-type-any",
			"title": "No weak schema types",
			"principle": "Weak schema types such as `ZodTypeAny` or a bare `ZodType` accept anything, so the validated value arrives untyped and the boundary stops proving anything. Name the precise schema type the boundary actually parses.",
			"scope": "zod",
			"origin": "uplinked eslint-rules/no-zod-type-any.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-zod-type-any.mjs",
						"presets": [
							"zod"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Zod-specific. The Python analogue is a schema typed as Any, which strict-types already forbids through mypy disallow_any_explicit and ruff ANN401."
					}
				]
			}
		},
		{
			"id": "prefer-zod-for-unknown-typeof",
			"title": "Parse unknown boundary values with a schema",
			"principle": "Hand-written `typeof` and `instanceof` checks on an unknown value validate one field at a time and drift from the shape the code expects. Parse the value once with a schema, and work with the typed result.",
			"scope": "zod",
			"origin": "uplinked eslint-rules/prefer-zod-for-unknown-typeof.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/prefer-zod-for-unknown-typeof.mjs",
						"presets": [
							"zod"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Deciding that an isinstance chain guards untyped input, and that a pydantic TypeAdapter belongs at that boundary, needs type-aware analysis that ruff and semgrep do not have; candidate for a future check."
					}
				]
			}
		},
		{
			"id": "no-light-mode-only-colors",
			"title": "No light-mode-only color utilities",
			"principle": "A hard-coded light neutral such as `bg-gray-100` looks correct until dark mode is on, and then it is unreadable. Use the semantic token, or pair the utility with an explicit dark counterpart.",
			"scope": "tailwind",
			"origin": "uplinked eslint-rules/no-light-mode-only-colors.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-light-mode-only-colors.mjs",
						"presets": [
							"tailwind"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Tailwind theme concern; Python source carries no light or dark colour variants."
					}
				]
			}
		},
		{
			"id": "no-raw-elevation",
			"title": "Elevation comes from named tokens",
			"principle": "Ad-hoc shadow utilities scatter a depth scale across the codebase and drift apart. Remove the decorative shadow, or use a named elevation token so layering stays one decision.",
			"scope": "tailwind",
			"origin": "uplinked eslint-rules/no-raw-elevation.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-raw-elevation.mjs",
						"presets": [
							"tailwind"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Shadow and elevation tokens are a CSS design-system concern."
					}
				]
			}
		},
		{
			"id": "no-small-text",
			"title": "No undersized or all-caps text",
			"principle": "Text below the minimum size is hard to read, arbitrary pixel sizes bypass the type scale, and all-caps copy is slower to read and mangled by screen readers. Use a shared typography token and sentence case, and mark a genuine exception in a comment.",
			"scope": "tailwind",
			"origin": "uplinked eslint-rules/no-small-text.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-small-text.mjs",
						"presets": [
							"react-native",
							"tailwind"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Type-scale rule enforced on stylesheets and JSX class names."
					}
				]
			}
		},
		{
			"id": "no-wide-arbitrary-breakpoints",
			"title": "No oversized or out-of-scale breakpoints",
			"principle": "A one-off breakpoint above the layout's widest named step, or a named step beyond it, splits responsive behaviour across two systems that no longer agree. Use a named responsive variant within the shared scale, and document a component-specific exception in a comment.",
			"scope": "tailwind",
			"origin": "uplinked eslint-rules/no-wide-arbitrary-breakpoints.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-wide-arbitrary-breakpoints.mjs",
						"presets": [
							"tailwind"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "Tailwind arbitrary breakpoint syntax does not exist in Python source."
					}
				]
			}
		},
		{
			"id": "no-brittle-e2e-selectors",
			"title": "Stable selectors in end-to-end tests",
			"principle": "Selectors built from DOM position, class attributes, or styling classes break when markup is restructured even though the product still works. Select by role, label, visible text, or test id.",
			"scope": "e2e",
			"origin": "uplinked eslint-rules/no-brittle-e2e-selectors.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-brittle-e2e-selectors.mjs",
						"presets": [
							"playwright"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "No bundled Python selector checker. This principle applies to Playwright and Selenium tests written in Python; prefer stable role, label, text or test-id locators as local guidance."
					}
				]
			}
		},
		{
			"id": "no-brittle-test-style-assertions",
			"title": "No exact style assertions in ordinary tests",
			"principle": "Asserting exact class strings or computed styles pins a test to today's styling rather than to what the user can do, so it fails on restyles and passes through real breakage. Assert user-visible behaviour, and keep deliberate visual coverage in files named for it.",
			"scope": "tests",
			"origin": "uplinked eslint-rules/no-brittle-test-style-assertions.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "rule",
						"rule": "eslint/rules/no-brittle-test-style-assertions.mjs",
						"presets": [
							"vitest",
							"jest",
							"playwright"
						]
					}
				],
				"python": [
					{
						"kind": "not-applicable",
						"reason": "No bundled Python style-assertion checker. This principle applies to Python browser tests; keep user-visible behavior assertions as local guidance and reserve exact styles for deliberate visual coverage."
					}
				]
			}
		},
		{
			"id": "import-sorting",
			"title": "Imports and exports keep one order",
			"principle": "One mechanical import order removes a whole class of merge conflicts and makes a missing dependency obvious at a glance. Let the linter decide the order rather than each author.",
			"scope": "any",
			"origin": "uplinked eslint-config/perfectionist-import-export-rules.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "plugin",
						"package": "eslint-plugin-perfectionist",
						"rules": [
							"perfectionist/sort-exports",
							"perfectionist/sort-imports",
							"perfectionist/sort-named-exports",
							"perfectionist/sort-named-imports"
						],
						"presets": [
							"base"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"I"
						]
					}
				]
			}
		},
		{
			"id": "import-hygiene",
			"title": "Imports resolve to one real module",
			"principle": "Duplicate, self-referential, and module-system-mixing imports produce modules that load twice or not at all, and the failure shows up far from the import. Keep one import per module and let it resolve.",
			"scope": "any",
			"origin": "uplinked eslint-config/import-x-config.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "plugin",
						"package": "eslint-plugin-import-x",
						"rules": [
							"import-x/no-duplicates",
							"import-x/no-import-module-exports",
							"import-x/no-self-import"
						],
						"presets": [
							"base"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"F401",
							"F811",
							"PLW0406"
						]
					}
				]
			}
		},
		{
			"id": "promise-correctness",
			"title": "Async results are settled exactly once",
			"principle": "A promise resolved twice, returned from a `finally`, or wrapped in a needless extra promise loses errors and results silently. Settle each async result once, on a path the reader can follow.",
			"scope": "any",
			"origin": "uplinked eslint-config/js-correctness-rules.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "plugin",
						"package": "eslint-plugin-promise",
						"rules": [
							"promise/no-multiple-resolved",
							"promise/no-return-in-finally",
							"promise/no-return-wrap",
							"promise/param-names",
							"promise/valid-params"
						],
						"presets": [
							"base"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"ASYNC",
							"RUF006"
						]
					}
				]
			}
		},
		{
			"id": "control-flow-correctness",
			"title": "Control flow says what it does",
			"principle": "Branches that are all identical, a `catch` that only rethrows, a loop counter changed inside the body, and a `map` callback with no return all read as intent but behave as an accident. Make the branch, the handler, and the loop do the thing they appear to do.",
			"scope": "any",
			"origin": "uplinked eslint-config/js-correctness-rules.cjs",
			"enforcement": {
				"javascript": [
					{
						"kind": "plugin",
						"package": "eslint",
						"rules": [
							"array-callback-return"
						],
						"presets": [
							"base"
						]
					},
					{
						"kind": "plugin",
						"package": "eslint-plugin-sonarjs",
						"rules": [
							"sonarjs/no-all-duplicated-branches",
							"sonarjs/no-useless-catch",
							"sonarjs/updated-loop-counter"
						],
						"presets": [
							"base"
						]
					}
				],
				"python": [
					{
						"kind": "ruff",
						"select": [
							"B",
							"RET",
							"SIM103",
							"PLW0120",
							"S110"
						]
					}
				]
			}
		},
		{
			"id": "typescript-recommended",
			"title": "The TypeScript recommended baseline stays on",
			"principle": "typescript-eslint's recommended set catches the TypeScript mistakes the compiler still accepts: unsafe `any`-adjacent types, empty object types, misused `new`, and stale triple-slash references. The typescript preset spreads it wholesale, so the catalog lists it rather than letting two dozen enforced rules go undocumented.",
			"scope": "typescript",
			"origin": "@typescript-eslint/eslint-plugin configs.recommended at 8.60.1",
			"enforcement": {
				"javascript": [
					{
						"kind": "plugin",
						"package": "@typescript-eslint/eslint-plugin",
						"rules": [
							"@typescript-eslint/ban-ts-comment",
