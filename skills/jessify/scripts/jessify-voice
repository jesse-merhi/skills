#!/usr/bin/env python3
"""Measure an author's voice from their corpus and score prose against it."""

from __future__ import annotations

import argparse
import json
import re
import statistics
import sys
from pathlib import Path
from collections import Counter
from typing import Any, Callable, Iterable, Optional


SCHEMA_VERSION = 1
WORD_RE = re.compile(r"[A-Za-z0-9]+(?:['’][A-Za-z0-9]+)?")
FIRST_PERSON_RE = re.compile(r"\b(?:i|me|my|mine|myself)\b", flags=re.IGNORECASE)
READER_ADDRESS_RE = re.compile(r"\b(?:you|your|yours|yourself)\b", flags=re.IGNORECASE)
CONTRACTION_RE = re.compile(r"\w['’](?:s|t|m|ve|ll|re|d)\b", flags=re.IGNORECASE)
STANCE_RE = re.compile(
    r"\b(?:probably|honestly|actually|basically|really|truly|obviously|frankly|"
    r"apparently|maybe|perhaps|somehow|genuinely|admittedly|literally|definitely|"
    r"pretty|quite|just|kind of|sort of|i think|i mean|i guess)\b",
    flags=re.IGNORECASE,
)
TURN_OPENER_RE = re.compile(
    r"(?:\A|(?<=[.!?…]\s))(?:So|But|And|Well|Look|See|Now|Anyway|Okay|Yes|No|Yet|"
    r"Alas|Turns|Except|Honestly|Then)\b"
)
ELLIPSIS_RE = re.compile(r"\.\.\.|…")
ASIDE_RE = re.compile(r"—|\(")
SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?…])\s+")

# Deliberately not measured: all-capitals words. Counted against this corpus they
# were 96% acronyms (AI, LLM, PR, GPT) and 4% emphasis, so the feature tracked
# topic vocabulary rather than voice, and enforcing it demanded acronyms.
PUNCHLINE_MAX = 6
LONG_SENTENCE_MIN = 30
# A feature the author uses in at least this share of passages is expected in any
# passage, so its complete absence is scored rather than tolerated.
PRESENCE_REQUIRED = 0.8
# Below this fraction of the profile's typical passage length, a score says more
# about the window than about the writing.
SHORT_PASSAGE_RATIO = 0.6

# Words a model reaches for when it is performing "good writing". Profiling keeps
# only the ones the author has never once written, so the flag is grounded in
# their corpus rather than in taste. Storing only the filtered list, never the
# corpus vocabulary, keeps a private corpus out of the profile file.
MACHINE_WORDS = (
    "delve leverage robust seamless navigate landscape realm underscore pivotal testament "
    "crucial furthermore moreover ultimately comprehensive innovative transformative holistic "
    "myriad plethora paradigm synergy utilize facilitate endeavor foster garner harness "
    "intricate nuanced multifaceted profound compelling remarkable notable significant "
    "essentially fundamentally inherently arguably notably importantly consequently "
    "elevate empower streamline optimize revolutionize unlock unleash embark journey "
    "tapestry beacon cornerstone bedrock backbone lifeblood catalyst gateway "
    "vital key essential critical paramount imperative "
    "emerged emerging evolving rapidly increasingly widely broadly "
    "ensure enable provide various numerous several certain "
    "approach methodology framework strategy solution capability functionality"
).split()

# A sentence stands alone when nothing in its opening points back: no pronoun, no
# demonstrative, no conjunction carrying the previous thought forward. A long run
# of them is the "one thing after another" that reads as a machine emptying its
# notes. Measured locally, as a run, because paragraph averages hide it.
CARRIES_ON_RE = re.compile(
    r"^(?:it|that|this|they|these|those|so|but|and|then|which|he|she|we|there|here|"
    r"because|yet|still|except|anyway|now|honestly|alas|well|look|see|if|when|"
    r"you|i|my|our|its|their|his|her|one|both|either|neither|all|none|each|"
    r"most|some|every|no)\b",
    flags=re.IGNORECASE,
)
ABSENCE_FLOOR = 0.25
# Presence between these bounds means the author uses a device in some passages
# and not others, which is the signature of a corpus spanning two registers.
MIXED_LOW = 0.4


def fail(message: str) -> None:
    raise SystemExit(message)


def words(text: str) -> list[str]:
    return WORD_RE.findall(text)


def sentences(text: str) -> list[str]:
    return [part.strip() for part in SENTENCE_SPLIT_RE.split(text) if part.strip()]


def load_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        fail(f"Missing file: {path}")
    rows = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            fail(f"{path}:{number}: invalid JSON: {exc}")
    return rows


def per_hundred(count: int, total: int) -> float:
    return round(100.0 * count / max(1, total), 3)


def measure(text: str) -> dict[str, float]:
    """Reduce a passage to the dimensions that separate this author from a model.

    Chosen by measuring real corpus passages against model output rather than by
    intuition. Two directions matter: models undershoot first person, sentence
    variety, and plain words, and they overshoot contractions and conjunction
    openers, which is what "write casually" produces when nobody is checking.
    """
    body = sentences(text)
    tokens = words(text)
    total = max(1, len(tokens))
    lengths = [len(words(part)) for part in body] or [1]
    mean_length = statistics.mean(lengths)
    return {
        "sentence_length": round(mean_length, 3),
        "sentence_variation": round(statistics.pstdev(lengths) / max(1.0, mean_length), 3),
        "punchlines": round(100.0 * sum(1 for n in lengths if n <= PUNCHLINE_MAX) / len(lengths), 3),
        "long_sentences": round(100.0 * sum(1 for n in lengths if n >= LONG_SENTENCE_MIN) / len(lengths), 3),
        "first_person": per_hundred(len(FIRST_PERSON_RE.findall(text)), total),
        "reader_address": per_hundred(len(READER_ADDRESS_RE.findall(text)), total),
        "contractions": per_hundred(len(CONTRACTION_RE.findall(text)), total),
        "stance_words": per_hundred(len(STANCE_RE.findall(text)), total),
        "questions": per_hundred(text.count("?"), total),
        "exclamations": per_hundred(text.count("!"), total),
        "ellipses": per_hundred(len(ELLIPSIS_RE.findall(text)), total),
        "asides": per_hundred(len(ASIDE_RE.findall(text)), total),
        "turn_openers": round(100.0 * len(TURN_OPENER_RE.findall(text)) / max(1, len(body)), 3),
        "word_length": round(sum(len(token) for token in tokens) / total, 3),
    }


FEATURE_ADVICE: dict[str, tuple[str, str]] = {
    "sentence_length": ("run sentences longer before stopping", "cut sentences shorter"),
    "sentence_variation": ("vary sentence length far more, long then very short", "even out wildly uneven sentence lengths"),
    "punchlines": ("land more short sentences of six words or fewer", "use fewer clipped one-liners"),
    "long_sentences": ("let more sentences run past thirty words", "break up the very long sentences"),
    "first_person": ("say I and me far more; put yourself in it", "step back from the first person"),
    "reader_address": ("address the reader as you", "address the reader less"),
    "contractions": ("use more contractions", "use fewer contractions; this reads as forced casualness"),
    "stance_words": ("add hedges and stance words like honestly or probably", "cut the stance adverbs"),
    "questions": ("ask the reader a direct question", "ask fewer questions"),
    "exclamations": ("allow an exclamation where the feeling is real", "cut the exclamation marks"),
    "ellipses": ("let a thought trail off with an ellipsis", "cut the ellipses"),
    "asides": ("add a parenthetical or dashed aside", "cut the asides"),
    "turn_openers": ("open a sentence with So or But", "stop opening sentences with So and But; it reads as fake conversation"),
    "word_length": ("use longer, more precise words", "use plainer, shorter words"),
}


def standalone_run(text: str) -> int:
    """Longest stretch of consecutive sentences that hook onto nothing before them."""
    longest = current = 0
    for sentence in sentences(text):
        if CARRIES_ON_RE.match(sentence.strip()):
            current = 0
        else:
            current += 1
            longest = max(longest, current)
    return longest


def foreign_words(profile: dict[str, Any], text: str) -> list[tuple[str, int]]:
    """Machine-favoured words this author has never written, found in a draft."""
    unused = set(profile.get("never_used", []))
    found = Counter(word for word in (w.lower() for w in words(text)) if word in unused)
    return found.most_common()


def percentile(values: list[float], fraction: float) -> float:
    if not values:
        return 0.0
    ordered = sorted(values)
    position = fraction * (len(ordered) - 1)
    lower = int(position)
    upper = min(lower + 1, len(ordered) - 1)
    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)


def build_profile(passages: list[str]) -> dict[str, Any]:
    samples = [measure(text) for text in passages]
    bands: dict[str, dict[str, float]] = {}
    for feature in measure("A sentence. Another one."):
        values = [sample[feature] for sample in samples]
        low = percentile(values, 0.10)
        high = percentile(values, 0.90)
        median = percentile(values, 0.50)
        presence = sum(1 for value in values if value > 0) / len(values)
        if presence >= PRESENCE_REQUIRED and median > 0:
            # A tenth percentile of zero would make the absence of this feature
            # unpunishable. That is wrong when the author uses it in nearly every
            # passage, and first person is the clearest case: a rewrite can drop
            # it entirely and still look like it sits inside the range.
            low = max(low, ABSENCE_FLOOR * median)
        bands[feature] = {
            "low": round(low, 3),
            "median": round(median, 3),
            "high": round(high, 3),
            "presence": round(presence, 3),
            # A band of zero width would make any deviation infinitely bad, so
            # fall back to the spread of the whole sample.
            "width": round(max(high - low, percentile(values, 0.75) - percentile(values, 0.25), 0.1), 3),
        }
    lengths = sorted(len(words(text)) for text in passages)
    seen = {word.lower() for text in passages for word in words(text)}
    runs = sorted(standalone_run(text) for text in passages)
    return {
        "schema_version": SCHEMA_VERSION,
        "passages": len(passages),
        # Bands describe passages of this size. Scoring something much shorter
        # exaggerates the distance, because a short passage cannot average out.
        "median_words": lengths[len(lengths) // 2],
        "never_used": [word for word in MACHINE_WORDS if word not in seen],
        "max_standalone_run": runs[-max(1, len(runs) // 10)],
        "features": bands,
    }


def scale_warning(profile: dict[str, Any], text: str) -> str:
    """Warn when a passage is too short for bands built from longer ones.

    Measured on a real article: its paragraphs of about 69 words scored a median
    0.073 against a profile built from 188-word chunks, the same article
    re-chunked to that size scored 0.032, and the whole piece scored 0.003. The
    prose did not change; only the window did.
    """
    expected = int(profile.get("median_words", 0))
    actual = len(words(text))
    if expected and actual < SHORT_PASSAGE_RATIO * expected:
        return (
            f"only {actual} words against a profile built from ~{expected}-word passages; "
            "the distance is inflated, so judge a longer stretch"
        )
    return ""


def score_text(profile: dict[str, Any], text: str) -> dict[str, Any]:
    """Penalise a passage for leaving the author's own range, in either direction.

    The distance compares candidates; it does not classify. Ranking four rewrites
    of one paragraph, it put the author's own first three times out of three.
    Judging arbitrary prose on its own, it fails: a 1,963-word article the author
    confirmed was not his scored 0.0036, better than his published writing at
    0.0131, because averaging any long text pulls every dimension to the median.
    At matched chunk scale it was still no better than chance, 0.0347 against his
    own 0.0324. Absolute judgement lives in the flags below, not in this number.

    Staying silent inside the band matters as much as penalising outside it. A
    single paragraph will not contain an ellipsis just because the author uses
    them sometimes, and demanding one would manufacture a tic. Features the
    author uses in nearly every passage are the exception: build_profile lifts
    their floor above zero so dropping them entirely is scored.
    """
    sample = measure(text)
    bands = profile["features"]
    deviations = []
    for feature, value in sample.items():
        band = bands.get(feature)
        if band is None:
            continue
        if value < band["low"]:
            penalty = (band["low"] - value) / band["width"]
            direction = "raise"
        elif value > band["high"]:
            penalty = (value - band["high"]) / band["width"]
            direction = "lower"
        else:
            continue
        deviations.append({
            "feature": feature,
            "value": value,
            "target_low": band["low"],
            "target_high": band["high"],
            "penalty": round(penalty, 3),
            "advice": FEATURE_ADVICE[feature][0 if direction == "raise" else 1],
        })
    deviations.sort(key=lambda row: -row["penalty"])
    total = sum(row["penalty"] for row in deviations)
    run = standalone_run(text)
    allowed = int(profile.get("max_standalone_run", 0))
    return {
        "distance": round(total / len(bands), 4),
        "too_short": scale_warning(profile, text),
        # Reported beside the distance, never folded into it. Both are noisier
        # than the measured bands, and averaging them in would corrupt a number
        # that currently separates this author from a model three times in three.
        "foreign_words": foreign_words(profile, text),
        "standalone_run": run,
        "listy": bool(allowed and run > allowed),
        "off_band": len(deviations),
        "deviations": deviations,
        "measured": sample,
    }


def revision_notes(result: dict[str, Any], limit: int = 4) -> list[str]:
    return [
        f"{row['advice']} (you are at {row['value']}, the author's range is "
        f"{row['target_low']} to {row['target_high']})"
        for row in result["deviations"][:limit]
    ]


def eligible_passages(
    workspace: Path,
    quality: set[str],
    minimum_words: int,
    split: Optional[str] = None,
) -> list[str]:
    units = load_jsonl(workspace / "corpus/units.jsonl")
    passages = [
        str(row.get("plain_text") or row.get("text") or "")
        for row in units
        if row.get("quality") in quality
        and (split is None or row.get("split") == split)
    ]
    return [text for text in passages if len(words(text)) >= minimum_words]


def find_exemplars(
    workspace: Path, quality: set[str], split: Optional[str] = None,
) -> dict[str, list[str]]:
    """Pull real sentences that show each device, so the card is evidence not adjectives."""
    probes: dict[str, Callable[[str], bool]] = {
        "a short punchline after a long sentence": lambda s: len(words(s)) <= PUNCHLINE_MAX,
        "a question put to the reader": lambda s: "?" in s and bool(READER_ADDRESS_RE.search(s)),
        "a thought trailing off": lambda s: bool(ELLIPSIS_RE.search(s)),
        "a self-aware aside": lambda s: bool(ASIDE_RE.search(s)) and bool(FIRST_PERSON_RE.search(s)),
        "a long winding sentence": lambda s: len(words(s)) >= LONG_SENTENCE_MIN,
    }
    found: dict[str, list[str]] = {name: [] for name in probes}
    for passage in eligible_passages(workspace, quality, 0, split):
        for sentence in sentences(passage):
            for name, matches in probes.items():
                if len(found[name]) < 3 and matches(sentence) and len(sentence) < 260:
                    found[name].append(sentence)
    return {name: rows for name, rows in found.items() if rows}


def command_profile(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    quality = {"canonical"} if args.canonical_only else {"canonical", "usable"}
    passages = eligible_passages(workspace, quality, args.min_words, args.split)
    if len(passages) < 8:
        fail(f"Only {len(passages)} passages of at least {args.min_words} words; ingest more writing")
    profile = build_profile(passages)
    # A corpus that mixes registers silently destroys the floors: if only half the
    # passages use first person, its absence stops being punishable and a rewrite
    # that never says "I" scores clean. Measured on real posts, adding one
    # impersonal how-to to two personal essays cut separation from 0.105 to 0.085
    # and stopped the detector catching prose written about "the author".
    mixed = [
        (name, band["presence"]) for name, band in profile["features"].items()
        if MIXED_LOW <= band["presence"] < PRESENCE_REQUIRED
    ]
    if mixed:
        print(
            "warning: inconsistent across this corpus, so absence is not scored: "
            + ", ".join(f"{name} ({presence:.0%} of passages)" for name, presence in mixed),
            file=sys.stderr,
        )
        print(
            "         this usually means the corpus mixes registers, such as personal "
            "essays with impersonal how-tos. Profile one register at a time.",
            file=sys.stderr,
        )
    profile["split"] = args.split or "all"
    profile["exemplars"] = find_exemplars(workspace, quality, args.split)
    path = workspace / "voice/profile.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(profile, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"profiled {len(passages)} passages into {path}")


def load_profile(workspace: Path) -> dict[str, Any]:
    path = workspace / "voice/profile.json"
    if not path.exists():
        fail(f"Missing voice profile: {path}; run jessify-voice profile first")
    return json.loads(path.read_text(encoding="utf-8"))


def command_card(args: argparse.Namespace) -> None:
    """Emit the style card that goes into a generation prompt."""
    workspace = Path(args.workspace).expanduser().resolve()
    profile = load_profile(workspace)
    bands = profile["features"]
    lines = [
        "# How this author writes",
        "",
        f"Measured over {profile['passages']} of their own passages. Aim for the middle",
        "of each range. Both edges are wrong: overshooting the casual markers reads as",
        "an impersonation, and undershooting reads as a corporate memo.",
        "",
        "## Measured ranges, per 100 words unless stated",
        "",
        "| Dimension | Their range | Typical |",
        "| --- | --- | --- |",
    ]
    show = lambda value: f"{value:.3g}"
    for feature, band in bands.items():
        label = feature.replace("_", " ")
        lines.append(
            f"| {label} | {show(band['low'])} to {show(band['high'])} | {show(band['median'])} |"
        )
    lines += [
        "",
        "## What that means in practice",
        "",
        f"- Sentence length swings hard. Typical mean is {show(bands['sentence_length']['median'])}"
        f" words, but {show(bands['long_sentences']['median'])}% of sentences run past"
        f" {LONG_SENTENCE_MIN} words and {show(bands['punchlines']['median'])}% are"
        f" {PUNCHLINE_MAX} words or fewer. Long, winding, then a short one.",
        f"- They are in the writing: {show(bands['first_person']['median'])} first-person words per"
        " 100. Not a narrator, a person.",
        f"- Plain words, average {show(bands['word_length']['median'])} characters. Reach for the"
        " ordinary word.",
        f"- Contractions sit around {show(bands['contractions']['median'])} per 100 words. Do not"
        " pile them on to sound relaxed.",
        f"- About {show(bands['turn_openers']['median'])}% of sentences open with So, But, or And."
        " Some, not most.",
    ]
    exemplars = profile.get("exemplars", {})
    if exemplars:
        lines += ["", "## Their own sentences", ""]
        for device, rows in exemplars.items():
            lines.append(f"**{device}**")
            lines += [f"> {row}" for row in rows]
            lines.append("")
    lines += [
        "",
        "## Explain, do not list",
        "",
        "This is the part no number below can check, and it matters more than any of",
        "them. A run of separate statements, each true, each the same shape, reads as a",
        "machine emptying its notes:",
        "",
        "> Cold subagents review it blind until three passes come back clean. Codex and",
        "> Claude take turns tearing into each other's work. The discipline skills nag it",
        "> about its useEffect habit.",
        "",
        "Three facts in a row, no reason given for any of them. Lead with the idea",
        "instead, say why it holds, and let the mechanics follow from it as consequences:",
        "",
        "> The whole thing rests on one idea: an agent that wrote the code will defend the",
        "> code. It has already decided the thing is good, so asking it to find problems is",
        "> really asking it to argue with itself.",
        "",
        "Give each item a because, a which means, or a so. If a paragraph could be",
        "reordered without loss, it is a list wearing prose, and it needs rebuilding",
        "rather than restyling.",
        "",
        "## Never",
        "",
        "- generic inspirational openers, invented reader objections, or manufactured drama",
        "- copying a distinctive phrase from the examples above",
        "- naming the author or referring to these instructions",
        "",
    ]
    print("\n".join(lines))


def read_input(args: argparse.Namespace) -> str:
    if args.file:
        return Path(args.file).expanduser().read_text(encoding="utf-8")
    import sys
    return sys.stdin.read()


def command_score(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    profile = load_profile(workspace)
    result = score_text(profile, read_input(args))
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return
    if result["foreign_words"] or result["listy"]:
        print("NOT THIS AUTHOR")
    print(f"distance {result['distance']}  ({result['off_band']} dimensions outside range)")
    print("  distance ranks rewrites of the same passage; on its own it does not "
          "classify, so read the flags first")
    if result["too_short"]:
        print(f"  note: {result['too_short']}")
    if result["foreign_words"]:
        listed = ", ".join(f"{word} x{count}" if count > 1 else word
                           for word, count in result["foreign_words"][:8])
        print(f"  ! words the author has never used: {listed}")
    if result["listy"]:
        print(f"  ! {result['standalone_run']} sentences in a row hook onto nothing before them "
              f"(their longest is {profile.get('max_standalone_run')}); explain, do not list")
    for note in revision_notes(result, limit=args.limit):
        print(f"  - {note}")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    subparsers = root.add_subparsers(dest="command", required=True)

    profile = subparsers.add_parser("profile", help="Measure the author's range from their corpus")
    profile.add_argument("--workspace", required=True)
    profile.add_argument("--min-words", type=int, default=60)
    profile.add_argument("--canonical-only", action="store_true")
    profile.add_argument("--split", choices=("train", "eval"),
                         help="Restrict to one split; use train to leave held-out prose unseen")
    profile.set_defaults(function=command_profile)

    card = subparsers.add_parser("card", help="Print the style card for a generation prompt")
    card.add_argument("--workspace", required=True)
    card.set_defaults(function=command_card)

    score = subparsers.add_parser("score", help="Score prose against the author's measured range")
    score.add_argument("--workspace", required=True)
    score.add_argument("--file")
    score.add_argument("--json", action="store_true")
    score.add_argument("--limit", type=int, default=5)
    score.set_defaults(function=command_score)
    return root


def main() -> None:
    args = parser().parse_args()
    args.function(args)


if __name__ == "__main__":
    main()
