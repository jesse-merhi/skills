#!/usr/bin/env python3
"""Generate and label privacy-safe local Jessify preference/evaluation batches."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import secrets
import socket
import subprocess
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from collections import Counter
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any, Iterable, Optional


SCHEMA_VERSION = 2
OLLAMA_BASE = "http://127.0.0.1:11434"
ROLES = {
    "opening", "setup", "explanation", "example", "transition", "aside",
    "argument", "reflection", "punchline", "conclusion", "unknown",
}
TAGS = {
    "generic-voice", "copied-phrasing", "bad-flow",
    "too-formal", "too-performative", "sounds-like-chat",
}
LEGACY_TAGS = {"factual-drift", "missing-detail"}
ACCEPTED_TAGS = TAGS | LEGACY_TAGS
SOURCE_VERDICTS = ("ok", "too-specific", "not-prose", "off-voice-source")
VERDICT_SCOPE = {
    "too-specific": "unit",
    "not-prose": "unit",
    "off-voice-source": "document",
}
WORD_RE = re.compile(r"[A-Za-z0-9]+(?:['’][A-Za-z0-9]+)?")
CONTENT_STOP_WORDS = {
    "about", "after", "again", "against", "also", "because", "before",
    "being", "below", "between", "could", "every", "first", "from",
    "have", "into", "itself", "might", "other", "passage", "should",
    "their", "there", "these", "thing", "those", "through", "using",
    "what", "when", "where", "which", "while", "with", "would", "write",
}
INSTRUCTION_LEAK_RE = re.compile(
    r"\b(?:neutral brief|must preserve|rhetorical role|source provided|"
    r"target passage|key constraints|we are writing|the requested passage|"
    r"these instructions)\b",
    flags=re.IGNORECASE,
)
MODEL_REASONING_LEAK_RE = re.compile(
    r"(?:^\s*(?:we need to|i need to|let(?:'|’)s (?:write|craft|produce))\b|"
    r"\bthe user wants me to\b|\bthey(?:'|’)ve given me\b|"
    r"\bword count limit\b|\bwhat (?:i|we) need to (?:write|produce|do)\b)",
    flags=re.IGNORECASE,
)
NON_PROSE_ARTIFACT_RE = re.compile(r"```|<[^>]+>|https?://|/Users/")
NUMBERED_STEP_RE = re.compile(r"^\s*\d+[.)]\s+")
FIRST_PERSON_RE = re.compile(r"\b(?:i|me|my|mine|myself)\b", flags=re.IGNORECASE)
READER_ADDRESS_RE = re.compile(r"\b(?:you|your|yours|yourself)\b", flags=re.IGNORECASE)
CONTRACTION_RE = re.compile(r"\w['’](?:s|t|m|ve|ll|re|d)\b", flags=re.IGNORECASE)
STANCE_RE = re.compile(
    r"\b(?:probably|honestly|actually|basically|really|truly|obviously|frankly|"
    r"apparently|maybe|perhaps|somehow|admittedly|alas|surely|arguably|"
    r"i think|i mean|i guess|i reckon|in my opinion|to be honest|kind of|sort of|"
    r"strong opinion|shock horror)\b",
    flags=re.IGNORECASE,
)
ASIDE_RE = re.compile(r"\.\.\.|…|!|\(|:\)|—")
TURN_OPENER_RE = re.compile(
    r"(?:\A|(?<=[.!?…]\s))(?:So|But|And|Well|Look|See|Now|Anyway|Okay|Yes|No|Yet|Alas|"
    r"Turns out|Except|Honestly)\b"
)
PROPER_NOUN_RE = re.compile(r"\b[A-Z][A-Za-z0-9.\-]+\b")
ACRONYM_RE = re.compile(r"\b[A-Z]{2,6}\b")
QUANTITY_RE = re.compile(r"\b\d[\d,.:/%]*\s*(?:am|pm|st|nd|rd|th|k|m|x)?\b", flags=re.IGNORECASE)
VOICE_DIMENSIONS: tuple[tuple[frozenset[str], str], ...] = (
    (frozenset({"question", "reader-address"}), "questions put to the reader"),
    (frozenset({"stance", "first-person"}), "hedged first-person opinion"),
    (frozenset({"punchline", "turn"}), "short punchlines after a turn"),
    (frozenset({"aside", "first-person"}), "self-aware asides"),
    (frozenset({"turn", "contraction"}), "conversational mid-thought turns"),
    (frozenset({"reader-address"}), "speaking straight to the reader"),
    (frozenset({"first-person"}), "first-person narration"),
)


def fail(message: str) -> None:
    raise SystemExit(message)


def words(text: str) -> list[str]:
    return [match.group(0).lower().replace("’", "'") for match in WORD_RE.finditer(text)]


def content_words(text: str) -> set[str]:
    return {word for word in words(text) if len(word) >= 4 and word not in CONTENT_STOP_WORDS}


def stable_id(prefix: str, *parts: str) -> str:
    digest = hashlib.sha256("\0".join(parts).encode("utf-8")).hexdigest()[:16]
    return f"{prefix}_{digest}"


def sentences(text: str) -> list[str]:
    return [part.strip() for part in re.split(r"(?<=[.!?…])\s+", text) if part.strip()]


def unit_prose(row: dict[str, Any]) -> str:
    """Prefer the markup-free rendering; fall back to the raw unit text."""
    return str(row.get("plain_text") or row.get("text") or "")


def plain_option(text: str) -> str:
    """Strip inline markup so no option can be identified by its formatting.

    The authentic passage arrives from a Markdown corpus and may carry code
    spans or emphasis that a generated candidate never has. Applied to every
    option equally, this removes a tell that has nothing to do with voice.
    """
    text = re.sub(r"`+", "", text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"\1", text)
    text = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", r"\1", text)
    text = re.sub(r"(?<![\w_])_([^_\n]+)_(?![\w_])", r"\1", text)
    return text.strip()


def voice_families(text: str) -> list[str]:
    """Name the distinct voice devices a passage uses.

    Counting families rather than raw marker density keeps a long expository
    passage from outscoring a short personal one purely on word count.
    """
    body = sentences(text)
    present = {
        "first-person": bool(FIRST_PERSON_RE.search(text)),
        "reader-address": bool(READER_ADDRESS_RE.search(text)),
        "contraction": bool(CONTRACTION_RE.search(text)),
        "stance": bool(STANCE_RE.search(text)),
        "aside": bool(ASIDE_RE.search(text)),
        "question": "?" in text,
        "turn": bool(TURN_OPENER_RE.search(text)),
        "punchline": any(1 <= len(words(part)) <= 6 for part in body),
    }
    return sorted(name for name, found in present.items() if found)


def specificity_score(text: str) -> float:
    """Distinct one-off references per hundred words.

    A passage crowded with named systems, versions, and timestamps cannot be
    rewritten from a brief without reciting them, so judging it measures
    recall rather than voice. Distinct references are counted once each: an
    entity repeated throughout a passage is one topic, not many details.
    """
    references: set[str] = {match.lower() for match in re.findall(r"`([^`]+)`", text)}
    body = re.sub(r"`[^`]+`", " ", text)
    for part in sentences(body):
        tail = part[1:] if part else ""
        references.update(match.lower() for match in PROPER_NOUN_RE.findall(tail))
        references.update(match.lower() for match in ACRONYM_RE.findall(part))
    references.update(match.lower() for match in QUANTITY_RE.findall(body))
    references.discard("i")
    return round(100.0 * len(references) / max(1, len(words(text))), 2)


def voice_dimension(text: str) -> str:
    """Name the transferable style question a case is best placed to answer."""
    families = set(voice_families(text))
    for candidate, description in VOICE_DIMENSIONS:
        if candidate <= families:
            return description
    return "everyday register"


def voice_case_reason(text: str, min_families: int, max_specificity: float) -> str:
    """Name why a passage cannot carry a fair voice judgment, or return "".

    The returned strings are a fixed vocabulary so callers can tally them without
    putting per-passage measurements into their output.

    Specificity is tested first because it is the failure the author notices: a
    passage can be unmistakably theirs and still be impossible to judge, because
    every option either recites the same list of names and timestamps or is
    visibly missing them.
    """
    if specificity_score(text) > max_specificity:
        return "too specific to judge"
    families = voice_families(text)
    if not {"first-person", "reader-address"} & set(families):
        return "impersonal exposition"
    if len(families) < min_families:
        return "too few voice devices"
    return ""


def fact_pressure(must_preserve: list[Any], target_text: str) -> float:
    """Required facts per hundred words of the passage being replaced."""
    return round(100.0 * len(must_preserve) / max(1, len(words(target_text))), 2)


def secure_workspace(workspace: Path) -> None:
    os.umask(0o077)
    workspace.mkdir(parents=True, exist_ok=True)
    workspace.chmod(0o700)
    for relative in ("rlhf", "rlhf/batches", "preferences", "eval"):
        path = workspace / relative
        path.mkdir(parents=True, exist_ok=True)
        path.chmod(0o700)


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"Missing file: {path}")
    except json.JSONDecodeError as exc:
        fail(f"{path}: invalid JSON: {exc}")
    if not isinstance(value, dict):
        fail(f"{path}: expected an object")
    return value


def load_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    rows: list[dict[str, Any]] = []
    for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError as exc:
            fail(f"{path}:{line_number}: invalid JSON: {exc}")
        if not isinstance(value, dict):
            fail(f"{path}:{line_number}: expected an object")
        rows.append(value)
    return rows


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)
    path.chmod(0o600)


def atomic_jsonl(path: Path, rows: Iterable[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)
    path.chmod(0o600)


def ollama_request(
    model: str,
    prompt: str,
    temperature: float,
    schema: Optional[dict[str, Any]] = None,
    max_tokens: int = 512,
) -> str:
    body: dict[str, Any] = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "think": False,
        "keep_alive": "10m",
        "options": {
            "temperature": temperature,
            "num_ctx": 8192,
            "num_predict": max_tokens,
        },
    }
    if schema is not None:
        body["format"] = schema
    request = urllib.request.Request(
        f"{OLLAMA_BASE}/api/generate",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    payload: Optional[dict[str, Any]] = None
    for request_attempt in range(2):
        try:
            with urllib.request.urlopen(request, timeout=300) as response:
                payload = json.loads(response.read().decode("utf-8"))
            break
        except socket.timeout:
            if request_attempt == 0:
                continue
            fail("Local Ollama request timed out twice")
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            fail(f"Local Ollama request failed: {exc}")
    if payload is None:
        fail("Local Ollama returned no response")
    output = str(payload.get("response", "")).strip()
    output = re.sub(r"\A<think>[\s\S]*?</think>\s*", "", output).strip()
    if not output:
        fail("Local Ollama returned an empty response")
    return output


def ensure_model(model: str) -> None:
    request = urllib.request.Request(f"{OLLAMA_BASE}/api/tags")
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        fail(f"Local Ollama is unavailable at {OLLAMA_BASE}: {exc}")
    names = {str(row.get("name", "")) for row in payload.get("models", [])}
    if model not in names:
        fail(f"Ollama model is not installed locally: {model}")


def has_ngram_overlap(left: str, right: str, size: int = 9) -> bool:
    left_words = words(left)
    right_words = words(right)
    if len(left_words) < size or len(right_words) < size:
        return False
    grams = {tuple(left_words[index:index + size]) for index in range(len(left_words) - size + 1)}
    return any(tuple(right_words[index:index + size]) in grams for index in range(len(right_words) - size + 1))


def trim_complete_sentences(text: str, max_words: int) -> str:
    boundaries = [
        match.end()
        for match in re.finditer(r"[.!?…][\"')\]]*(?=\s|$)", text)
    ]
    eligible = [text[:boundary].strip() for boundary in boundaries]
    eligible = [candidate for candidate in eligible if 20 <= len(words(candidate)) <= max_words]
    return eligible[-1] if eligible else ""


def reverse_schema() -> dict[str, Any]:
    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["neutral_brief", "rhetorical_role", "must_preserve", "structure"],
        "properties": {
            "neutral_brief": {"type": "string"},
            "rhetorical_role": {"type": "string", "enum": sorted(ROLES - {"unknown"})},
            "must_preserve": {"type": "array", "items": {"type": "string"}},
            "structure": {"type": "array", "items": {"type": "string"}},
        },
    }


def passage_schema() -> dict[str, Any]:
    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["passage"],
        "properties": {"passage": {"type": "string"}},
    }


def candidate_review_schema() -> dict[str, Any]:
    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["grounded", "finished_passage", "failure"],
        "properties": {
            "grounded": {"type": "boolean"},
            "finished_passage": {"type": "boolean"},
            "failure": {
                "type": "string",
                "enum": ["none", "missing-fact", "invented-fact", "meta-commentary"],
            },
        },
    }


def clean_candidate(model: str, draft: str, max_tokens: int) -> str:
    prompt = f"""Extract only the finished first-person blog passage from DRAFT.
Remove task analysis, planning, prompt restatement, labels, constraint lists,
and commentary about how to write it. Preserve the draft's actual claims and
do not add or rewrite facts. Return only JSON matching the supplied schema.

DRAFT:
{draft}
"""
    raw = ollama_request(
        model,
        prompt,
        0.0,
        passage_schema(),
        max_tokens=max_tokens,
    )
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        return ""
    return str(value.get("passage", "")).strip()


def review_candidate(model: str, case: dict[str, Any], candidate: str) -> tuple[bool, str]:
    source = {
        "neutral_brief": case["neutral_brief"],
        "must_preserve": case["must_preserve"],
        "structure": case["structure"],
    }
    source_terms = content_words(" ".join([
        str(case["neutral_brief"]),
        *(str(item) for item in case["must_preserve"]),
    ]))
    candidate_terms = content_words(candidate)
    minimum_overlap = max(2, math.ceil(len(source_terms) * 0.2))
    if len(source_terms & candidate_terms) < minimum_overlap:
        return False, "insufficient-source-overlap"
    prompt = f"""Act as a strict data-quality filter, not a writing assistant.

Set grounded=false when CANDIDATE omits a required fact or introduces any
specific technology, system behavior, motivation, chronology, or outcome that
is not supported by SOURCE. Set finished_passage=false when it contains task
analysis, planning, prompt commentary, instructions, metadata, or an outline
instead of publishable prose. Do not reward fluency. Return only JSON matching
the supplied schema.

SOURCE:
{json.dumps(source, ensure_ascii=False, indent=2)}

CANDIDATE:
{candidate}
"""
    raw = ollama_request(model, prompt, 0.0, candidate_review_schema(), max_tokens=160)
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        return False, "failed the grounding review"
    grounded = value.get("grounded") is True
    finished = value.get("finished_passage") is True
    failure = str(value.get("failure", "failed-grounding-review")).strip()
    return grounded and finished, failure or "failed-grounding-review"


def copied_brief_field(passage: str, fields: Iterable[Any]) -> bool:
    """True when any brief field lifts a long phrase straight from the passage.

    Short reuse is unavoidable and fine: a required fact may well be "over 530
    security advisories". What breaks the comparison is a whole clause of the
    author's own prose arriving in the brief, because every candidate then
    reproduces it verbatim.
    """
    return any(has_ngram_overlap(passage, str(field), 9) for field in fields)


def brief_has_lexical_support(passage: str, brief: dict[str, Any]) -> bool:
    passage_terms = content_words(passage)
    fact_terms = content_words(" ".join(str(item) for item in brief["must_preserve"]))
    if len(fact_terms & passage_terms) < max(2, math.ceil(len(fact_terms) * 0.4)):
        return False
    brief_terms = content_words(str(brief["neutral_brief"]))
    if len(brief_terms & passage_terms) < max(2, math.ceil(len(brief_terms) * 0.2)):
        return False
    return True


def review_brief(passage: str, brief: dict[str, Any]) -> tuple[bool, str]:
    grounded = brief_has_lexical_support(passage, brief)
    return grounded, "none" if grounded else "brief lacked deterministic lexical support"


def build_brief(model: str, unit: dict[str, Any]) -> dict[str, Any]:
    passage = str(unit["plain_text"])
    prompt = f"""Convert TARGET PASSAGE into a style-neutral writing brief.
Return only one JSON object matching the supplied schema.

Rules:
- Preserve facts, claims, chronology, uncertainty, and intended reader movement.
- Paraphrase. Do not quote distinctive wording, jokes, cadence, punctuation, or voice.
- Do not use the author's name and do not invent or repair facts.
- Every must_preserve item names one fact in under eight words. Never copy a
  clause or sentence from the passage into it; a quoted sentence is the author's
  prose, not a fact.

Section: {unit.get('section', 'Unknown')}
TARGET PASSAGE:
{passage}
"""
    last_error = ""
    for attempt in range(5):
        candidate = ollama_request(
            model,
            prompt + (f"\nPrevious attempt failed: {last_error}" if last_error else ""),
            0.1,
            reverse_schema(),
            max_tokens=384,
        )
        try:
            parsed = json.loads(candidate)
        except json.JSONDecodeError as exc:
            last_error = f"invalid JSON ({exc})"
            continue
        brief = str(parsed.get("neutral_brief", "")).strip()
        role = str(parsed.get("rhetorical_role", "")).strip()
        preserve = parsed.get("must_preserve")
        structure = parsed.get("structure")
        if role not in ROLES - {"unknown"}:
            last_error = "unsupported rhetorical role"
        elif not brief or not isinstance(preserve, list) or not isinstance(structure, list):
            last_error = "missing required fields"
        elif len(preserve) < 1 or len(structure) < 1:
            last_error = "must_preserve and structure cannot be empty"
        elif not all(isinstance(item, str) and item.strip() for item in preserve + structure):
            last_error = "list fields require non-empty strings"
        elif re.search(r"\bjesse\b", brief, flags=re.IGNORECASE):
            last_error = "brief names the author"
        elif copied_brief_field(passage, [brief, *preserve, *structure]):
            # A required fact quoted straight from the passage is not a fact, it
            # is the author's sentence. Every candidate then opens with the same
            # line and the comparison stops being about voice.
            last_error = "brief quotes a nine-word phrase from the target"
        else:
            result = {
                "neutral_brief": brief,
                "rhetorical_role": role,
                "must_preserve": [str(item).strip() for item in preserve],
                "structure": [str(item).strip() for item in structure],
            }
            grounded, reason = review_brief(passage, result)
            if grounded:
                return result
            last_error = f"brief was not grounded in its target ({reason})"
    fail(f"Could not produce a safe neutral brief for {unit.get('id')}: {last_error}")


def retrieval_examples(
    units: list[dict[str, Any]],
    case: dict[str, Any],
    limit: int = 4,
    vetoes: Optional[dict[str, set[str]]] = None,
) -> list[dict[str, Any]]:
    """Pick voice references, honouring the sources the author has ruled out.

    A passage the author rejected as too specific or not their voice must not
    come back as evidence of how they write.
    """
    vetoed_units = (vetoes or {}).get("unit", set())
    vetoed_documents = (vetoes or {}).get("document", set())
    query_words = words(str(case["neutral_brief"]))
    document_frequency: Counter[str] = Counter()
    eligible = [
        row for row in units
        if row.get("split") == "train"
        and row.get("quality") in {"canonical", "usable"}
        and row.get("document_id") != case.get("document_id")
        and str(row.get("id", "")) not in vetoed_units
        and str(row.get("document_id", "")) not in vetoed_documents
        and is_prose_unit(row)
    ]
    for row in eligible:
        document_frequency.update(set(words(str(row.get("plain_text", "")))))
    scored: list[tuple[float, dict[str, Any]]] = []
    count = max(1, len(eligible))
    for row in eligible:
        row_words = Counter(words(str(row.get("plain_text", ""))))
        score = 0.0
        for token in set(query_words):
            if token in row_words:
                score += (1.0 + math.log(row_words[token])) * math.log((count + 1) / (document_frequency[token] + 1))
        if row.get("section") == case.get("section"):
            score += 0.25
        quality = 1.0 if row.get("quality") == "canonical" else 0.7
        # A reference is there to show how the author sounds, so prefer passages
        # that actually use their devices over ones that merely share topic words.
        voice = 1.0 + 0.08 * len(voice_families(unit_prose(row)))
        scored.append((score * quality * voice, row))
    scored.sort(key=lambda item: (-item[0], str(item[1].get("id", ""))))
    return [row for score, row in scored[:limit] if score > 0]


def candidate_prompt(case: dict[str, Any], examples: list[dict[str, Any]]) -> str:
    target_word_budget = len(words(str(case.get("target_text", ""))))
    source = {
        "neutral_brief": case["neutral_brief"],
        "rhetorical_role": case["rhetorical_role"],
        "must_preserve": case["must_preserve"],
        "structure": case["structure"],
        "preceding_context": case.get("preceding_context", ""),
        "following_context": case.get("following_context", ""),
    }
    example_text = ""
    if examples:
        blocks = []
        for index, example in enumerate(examples, 1):
            blocks.append(f"REFERENCE {index} ({example.get('section', 'passage')}):\n{example.get('plain_text', '')}")
        example_text = "\n\nVoice references from different training documents:\n" + "\n\n".join(blocks)
    return f"""Write one first-person technical blog passage from the source below.

Preserve every required fact. Add no claim, motivation, chronology, or certainty.
Make it sound like a real person thinking aloud: concrete, conversational, and
specific. Avoid generic inspirational language, fake audience objections, and
performative drama. Produce finished blog or how-to prose, not a Slack message,
chat reply, outline, metadata block, or field/value list. Match the rhetorical
job and connect naturally to context.
Aim for roughly {target_word_budget} words and do not exceed {max(45, round(target_word_budget * 1.6))} words.
Return only the finished passage with no preface.

SOURCE:
{json.dumps(source, ensure_ascii=False, indent=2)}
{example_text}

References are evidence of voice only. Never copy a distinctive phrase or fact
from them, and never mention the author or these instructions.
"""


def generate_output(model: str, case: dict[str, Any], examples: list[dict[str, Any]]) -> str:
    prompt = candidate_prompt(case, examples)
    last_error = ""
    target_words = len(words(str(case.get("target_text", ""))))
    max_words = max(45, round(target_words * 1.6))
    max_tokens = min(640, max(96, round(max_words * 1.6)))
    for attempt in range(5):
        output = ollama_request(
            model,
            prompt + (f"\nRewrite because the previous output {last_error}." if last_error else ""),
            0.65,
            max_tokens=max_tokens,
        )
        if MODEL_REASONING_LEAK_RE.search(output):
            last_error = "contained model reasoning instead of a finished passage"
            continue
        if INSTRUCTION_LEAK_RE.search(output) or output.lstrip().startswith("{"):
            output = clean_candidate(model, output, max_tokens)
        if len(words(output)) < 20:
            last_error = "was too short"
            continue
        if INSTRUCTION_LEAK_RE.search(output) or output.lstrip().startswith("{"):
            last_error = "repeated prompt or schema language"
            continue
        if len(words(output)) > max_words or output[-1] not in ".?!…\"')":
            output = trim_complete_sentences(output, max_words)
            if not output:
                last_error = f"had no complete 20-{max_words} word passage"
                continue
        copied = next((row for row in examples if has_ngram_overlap(str(row.get("plain_text", "")), output, 9)), None)
        if copied is not None:
            last_error = "copied a long phrase from a reference"
            continue
        accepted, review_reason = review_candidate(model, case, output)
        if not accepted:
            last_error = review_reason
            continue
        return output
    fail(f"Could not generate a safe candidate for {case.get('case_id')}: {last_error}")


def content_recall(reference: str, candidate: str) -> float:
    reference_terms = content_words(reference)
    if not reference_terms:
        return 0.0
    return len(reference_terms & content_words(candidate)) / len(reference_terms)


def echo_share(reference: str, candidate: str, size: int = 5) -> float:
    """Share of the reference's word runs that survive verbatim in the candidate.

    A flattened rewrite keeps factual phrases, so a single long shared run proves
    nothing. What separates a rewrite from an echo is how much of the original
    sequence is still intact.
    """
    left = words(reference)
    right = words(candidate)
    if len(left) < size:
        return 0.0
    grams = [tuple(left[index:index + size]) for index in range(len(left) - size + 1)]
    present = {tuple(right[index:index + size]) for index in range(max(0, len(right) - size + 1))}
    return sum(gram in present for gram in grams) / len(grams)


def generate_flattened_output(model: str, authentic: str) -> tuple[str, str]:
    """Rewrite the authentic passage in a flat register, keeping its content.

    Every other option is reconstructed from a lossy brief, so the authentic
    passage is the only one carrying the full set of details. That lets a
    labeller spot it by richness instead of by voice. A flattened twin restores
    the comparison: same content, drained register, so the only remaining
    difference is how it sounds. It also yields one preference pair per case
    whose signal is unambiguously about voice.

    Returns the rewrite and an empty reason, or an empty rewrite and the reason
    the last attempt was rejected, so a skipped contrast is never silent.
    """
    prompt = f"""Rewrite PASSAGE as neutral corporate documentation.

Keep every fact, name, number, claim, and the order they appear in. Change only
how it sounds: remove first-person warmth, humour, asides, ellipses, direct
questions to the reader, exclamations, and short punchy sentences. Use uniform
declarative sentences and standard business register. Do not summarise, do not
shorten below the original length, and do not add commentary about the rewrite.
Return only the rewritten prose.

PASSAGE:
{authentic}
"""
    authentic_families = len(voice_families(authentic))
    budget = len(words(authentic))
    max_tokens = min(900, max(160, round(budget * 2.0)))
    reason = "no attempt was made"
    for attempt in range(3):
        output = ollama_request(model, prompt, 0.2, max_tokens=max_tokens)
        if INSTRUCTION_LEAK_RE.search(output) or MODEL_REASONING_LEAK_RE.search(output):
            reason = "leaked prompt or reasoning"
        elif not 0.6 * budget <= len(words(output)) <= 1.8 * budget:
            reason = "length left the band around the original"
        elif content_recall(authentic, output) < 0.6:
            reason = "dropped too much of the original content"
        elif len(voice_families(output)) >= authentic_families:
            reason = "kept as many voice devices as the original"
        elif echo_share(authentic, output) > 0.5:
            reason = "echoed the original instead of rewriting it"
        else:
            return output, ""
    return "", reason


def generate_adapter_output(
    workspace: Path,
    model: str,
    adapter_path: Path,
    case: dict[str, Any],
) -> str:
    python = workspace / ".venv/bin/python"
    runner = Path(__file__).resolve().parent / "jessify-mlx-runner"
    if not python.exists():
        fail("Missing private MLX environment; run jessify-train-local train first")
    if not adapter_path.exists():
        fail(f"Missing adapter: {adapter_path}")
    try:
        adapter_path.resolve().relative_to(workspace)
    except ValueError:
        fail("The private adapter must live inside the Jessify workspace")
    environment = os.environ.copy()
    cache = workspace / "model-cache/huggingface"
    environment.update({
        "HF_HOME": str(cache),
        "HUGGINGFACE_HUB_CACHE": str(cache / "hub"),
        "TOKENIZERS_PARALLELISM": "false",
    })
    result = subprocess.run(
        [
            str(python), str(runner), "--model", model,
            "--adapter-path", str(adapter_path),
        ],
        input=candidate_prompt(case, []),
        text=True,
        capture_output=True,
        env=environment,
        check=False,
    )
    if result.returncode != 0:
        fail(f"Local MLX adapter failed: {result.stderr.strip()}")
    output = result.stdout.strip()
    if len(words(output)) < 20:
        fail(f"Local MLX adapter produced a short response for {case.get('case_id')}")
    return output


def batch_dir(workspace: Path, name: str) -> Path:
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", name):
        fail("Batch name must use lowercase letters, digits, and hyphens")
    return workspace / "rlhf/batches" / name


def is_prose_unit(row: dict[str, Any]) -> bool:
    text = str(row.get("text", ""))
    if len(words(text)) < 60 or NON_PROSE_ARTIFACT_RE.search(text):
        return False
    if NUMBERED_STEP_RE.search(str(row.get("section", ""))):
        return False
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines:
        return False
    if sum(line.endswith(":") for line in lines) >= 2:
        return False
    structured = sum(bool(re.match(r"^([-*]|\d+[.)])\s+", line)) for line in lines)
    return structured * 5 < len(lines) * 2


def choose_units(
    units: list[dict[str, Any]],
    split: str,
    limit: int,
    seed: str,
    vetoes: Optional[dict[str, set[str]]] = None,
    min_voice_families: int = 3,
    max_specificity: float = 6.0,
) -> tuple[list[dict[str, Any]], Counter[str]]:
    """Pick source-diverse, voice-bearing units and report why others were skipped.

    Returns the selection plus a text-free tally of rejection reasons so a
    caller can report gate behaviour without printing corpus content.
    """
    vetoed_units = (vetoes or {}).get("unit", set())
    vetoed_documents = (vetoes or {}).get("document", set())
    skipped: Counter[str] = Counter()
    eligible: list[dict[str, Any]] = []
    for row in units:
        if row.get("split") != split or row.get("quality") not in {"canonical", "usable"}:
            continue
        if str(row.get("document_id", "")) in vetoed_documents:
            skipped["vetoed document"] += 1
            continue
        if str(row.get("id", "")) in vetoed_units:
            skipped["vetoed unit"] += 1
            continue
        if not is_prose_unit(row):
            skipped["not prose"] += 1
            continue
        reason = voice_case_reason(unit_prose(row), min_voice_families, max_specificity)
        if reason:
            skipped[reason] += 1
            continue
        eligible.append(row)
    if not eligible:
        fail(
            f"No eligible {split} units after the voice gate "
            f"(skipped: {dict(skipped.most_common()) or 'none'}). "
            "Ingest more finished prose, or relax --min-voice-families/--max-specificity."
        )
    by_document: dict[str, list[dict[str, Any]]] = {}
    for row in eligible:
        by_document.setdefault(str(row.get("document_id", "")), []).append(row)
    for rows in by_document.values():
        rows.sort(key=lambda row: (
            -len(voice_families(unit_prose(row))),
            specificity_score(unit_prose(row)),
            hashlib.sha256(f"{seed}\0{row.get('id')}".encode("utf-8")).hexdigest(),
        ))
    document_ids = sorted(
        by_document,
        key=lambda document_id: hashlib.sha256(f"{seed}\0{document_id}".encode("utf-8")).hexdigest(),
    )
    selected: list[dict[str, Any]] = []
    round_index = 0
    while len(selected) < limit:
        added = False
        for document_id in document_ids:
            rows = by_document[document_id]
            if round_index < len(rows):
                selected.append(rows[round_index])
                added = True
                if len(selected) == limit:
                    break
        if not added:
            break
        round_index += 1
    return selected, skipped


def load_vetoes(workspace: Path) -> dict[str, set[str]]:
    """Read the author's source rejections into unit and document veto sets."""
    vetoes: dict[str, set[str]] = {"unit": set(), "document": set()}
    for row in load_jsonl(workspace / "rlhf/eligibility.jsonl"):
        scope = str(row.get("scope", ""))
        identifier = str(row.get("id", ""))
        if scope in vetoes and identifier:
            vetoes[scope].add(identifier)
    return vetoes


def record_veto(workspace: Path, row: dict[str, Any]) -> None:
    """Append one source veto, keyed so repeated labelling stays idempotent."""
    path = workspace / "rlhf/eligibility.jsonl"
    rows = load_jsonl(path)
    key = (str(row["scope"]), str(row["id"]), str(row["verdict"]))
    if any((str(item.get("scope")), str(item.get("id")), str(item.get("verdict"))) == key for item in rows):
        return
    rows.append(row)
    atomic_jsonl(path, rows)


def command_prepare(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    secure_workspace(workspace)
    ensure_model(args.model)
    purpose = args.purpose
    split = "train" if purpose == "preference" else "eval"
    directory = batch_dir(workspace, args.name)
    if directory.exists() and not args.resume:
        fail(f"Batch already exists: {directory}; use --resume or choose another name")
    if directory.exists() and args.resume and (directory / "meta.json").exists():
        existing_meta = load_json(directory / "meta.json")
        expected = {
            "purpose": purpose,
            "split": split,
            "model": args.model,
            "seed": args.seed,
        }
        mismatches = [key for key, value in expected.items() if existing_meta.get(key) != value]
        expected_adapter = str(Path(args.adapter_path).expanduser().resolve()) if args.adapter_path else ""
        if str(existing_meta.get("adapter_path", "")) != expected_adapter:
            mismatches.append("adapter-path")
        if expected_adapter and existing_meta.get("mlx_model") != args.mlx_model:
            mismatches.append("mlx-model")
        if mismatches:
            fail(f"Cannot resume batch with changed settings: {', '.join(mismatches)}")
    directory.mkdir(parents=True, exist_ok=True)
    directory.chmod(0o700)
    units = load_jsonl(workspace / "corpus/units.jsonl")
    vetoes = load_vetoes(workspace)
    selected, skipped = choose_units(
        units, split, len(units), args.seed,
        vetoes=vetoes,
        min_voice_families=args.min_voice_families,
        max_specificity=args.max_specificity,
    )
    if skipped:
        print(f"voice gate skipped: {dict(skipped.most_common())}", file=sys.stderr)
    private_path = directory / "private-cases.jsonl"
    existing = {str(row["case_id"]): row for row in load_jsonl(private_path)} if args.resume else {}
    rejected_path = workspace / "rlhf/rejected" / f"{args.name}.jsonl"
    rejected_rows = load_jsonl(rejected_path) if args.resume else []
    rejected_ids = {str(row.get("case_id", "")) for row in rejected_rows}
    for index, unit in enumerate(selected, 1):
        if len(existing) >= args.limit:
            break
        case_id = stable_id("rlhf", args.name, str(unit["id"]))
        if case_id in existing:
            print(f"[{len(existing)}/{args.limit}] resumed {case_id}", file=sys.stderr)
            continue
        if case_id in rejected_ids:
            continue
        print(f"[{len(existing) + 1}/{args.limit}] building {case_id}", file=sys.stderr)
        try:
            brief = build_brief(args.model, unit)
            pressure = fact_pressure(brief["must_preserve"], unit_prose(unit))
            if pressure > args.max_fact_pressure:
                fail(
                    f"Could not produce a safe neutral brief for {unit.get('id')}: "
                    f"needs {pressure} facts per 100 words, so judging it would test "
                    f"recall of specifics rather than voice"
                )
            case: dict[str, Any] = {
                "schema_version": SCHEMA_VERSION,
                "case_id": case_id,
                "source_unit_id": unit["id"],
                "document_id": unit["document_id"],
                "section": unit.get("section", ""),
                "split": split,
                "target_text": unit["text"],
                "preceding_context": unit.get("preceding_context", ""),
                "following_context": unit.get("following_context", ""),
                "voice_dimension": voice_dimension(unit_prose(unit)),
                "specificity": specificity_score(unit_prose(unit)),
                "fact_pressure": pressure,
                **brief,
            }
            references = retrieval_examples(units, case, vetoes=vetoes)
            raw_options = [
                {"system": f"{args.model}-baseline", "output": generate_output(args.model, case, [])},
                {"system": f"{args.model}-retrieval", "output": generate_output(args.model, case, references)},
                {"system": "authentic-reference", "output": str(unit["text"])},
            ]
            if args.contrast:
                flattened, contrast_reason = generate_flattened_output(args.model, unit_prose(unit))
                if flattened:
                    raw_options.append({"system": "voice-stripped-authentic", "output": flattened})
                else:
                    print(
                        f"no content-matched contrast for {case_id}: {contrast_reason}",
                        file=sys.stderr,
                    )
            if args.adapter_path:
                adapter_path = Path(args.adapter_path).expanduser().resolve()
                raw_options.append({
                    "system": f"adapter:{adapter_path.name}",
                    "output": generate_adapter_output(workspace, args.mlx_model, adapter_path, case),
                })
        except SystemExit as exc:
            reason = str(exc)
            if not reason.startswith("Could not produce a safe") and not reason.startswith("Could not generate a safe"):
                raise
            rejected_rows.append({
                "schema_version": SCHEMA_VERSION,
                "case_id": case_id,
                "source_unit_id": unit["id"],
                "document_id": unit["document_id"],
                "reason": reason,
            })
            rejected_ids.add(case_id)
            atomic_jsonl(rejected_path, rejected_rows)
            print(f"quarantined {case_id}: {reason}", file=sys.stderr)
            continue
        raw_options.sort(key=lambda row: hashlib.sha256(f"{args.seed}\0{case_id}\0{row['system']}".encode("utf-8")).hexdigest())
        case["options"] = [
            {"label": chr(ord("A") + option_index), **option, "output": plain_option(str(option["output"]))}
            for option_index, option in enumerate(raw_options)
        ]
        existing[case_id] = case
        atomic_jsonl(private_path, existing.values())
    if len(existing) < args.limit:
        fail(f"Only {len(existing)} of {args.limit} requested cases passed local quality gates")
    private_rows = list(existing.values())
    private_rows.sort(key=lambda row: next((index for index, item in enumerate(selected) if item["id"] == row["source_unit_id"]), 10**9))
    atomic_jsonl(private_path, private_rows)
    blind_rows = []
    key_rows = []
    for case in private_rows:
        blind_rows.append({
            "schema_version": SCHEMA_VERSION,
            "case_id": case["case_id"],
            "neutral_brief": case["neutral_brief"],
            "rhetorical_role": case["rhetorical_role"],
            "must_preserve": case["must_preserve"],
            "structure": case["structure"],
            "preceding_context": case.get("preceding_context", ""),
            "following_context": case.get("following_context", ""),
            "voice_dimension": case.get("voice_dimension", ""),
            "options": [{"label": option["label"], "output": option["output"]} for option in case["options"]],
        })
        key_rows.append({
            "case_id": case["case_id"],
            "options": [{"label": option["label"], "system": option["system"]} for option in case["options"]],
        })
    atomic_jsonl(directory / "blind-cases.jsonl", blind_rows)
    atomic_jsonl(directory / "blind-key.jsonl", key_rows)
    atomic_json(directory / "meta.json", {
        "schema_version": SCHEMA_VERSION,
        "name": args.name,
        "purpose": purpose,
        "split": split,
        "model": args.model,
        "seed": args.seed,
        "count": len(blind_rows),
        "adapter_path": str(Path(args.adapter_path).expanduser().resolve()) if args.adapter_path else "",
        "mlx_model": args.mlx_model if args.adapter_path else "",
        "min_voice_families": args.min_voice_families,
        "max_specificity": args.max_specificity,
        "max_fact_pressure": args.max_fact_pressure,
        "contrast": bool(args.contrast),
    })
    atomic_jsonl(directory / "choices.jsonl", load_jsonl(directory / "choices.jsonl"))
    print(f"prepared {len(blind_rows)} {purpose} cases in {directory}")


def validate_choice(case: dict[str, Any], payload: dict[str, Any]) -> dict[str, Any]:
    case_id = str(payload.get("case_id", ""))
    allowed_labels = {str(option["label"]) for option in case["options"]}
    label = str(payload.get("label", ""))
    if label not in allowed_labels | {"none"}:
        fail(f"Invalid label for {case_id}: {label}")
    tags = payload.get("tags", [])
    if not isinstance(tags, list) or any(str(tag) not in ACCEPTED_TAGS for tag in tags):
        fail(f"Invalid tags for {case_id}")
    unfaithful = payload.get("unfaithful", [])
    if not isinstance(unfaithful, list) or any(str(item) not in allowed_labels for item in unfaithful):
        fail(f"Invalid faithfulness flags for {case_id}")
    unfaithful_labels = sorted(set(str(item) for item in unfaithful))
    note = str(payload.get("note", "")).strip()
    edited = str(payload.get("edited_output", "")).strip()
    if len(note) > 1000 or len(edited) > 20000:
        fail(f"Choice text is too long for {case_id}")
    confidence = str(payload.get("confidence", "medium"))
    if confidence not in {"low", "medium", "high"}:
        fail(f"Invalid confidence for {case_id}")
    source_verdict = str(payload.get("source_verdict", "ok")) or "ok"
    if source_verdict not in SOURCE_VERDICTS:
        fail(f"Invalid source verdict for {case_id}: {source_verdict}")
    if label in unfaithful_labels and not edited:
        fail(
            f"Option {label} is flagged as changing the facts for {case_id}. "
            "Edit it into something you would publish, or pick another option."
        )
    return {
        "schema_version": SCHEMA_VERSION,
        "case_id": case_id,
        "label": label,
        "tags": sorted(set(str(tag) for tag in tags)),
        "unfaithful": unfaithful_labels,
        "source_verdict": source_verdict,
        "confidence": confidence,
        "note": note,
        "edited_output": edited,
    }


def export_preferences(workspace: Path, directory: Path) -> dict[str, int]:
    meta = load_json(directory / "meta.json")
    if meta.get("purpose") != "preference":
        fail("Held-out evaluation choices can never be exported as training preferences")
    private = {str(row["case_id"]): row for row in load_jsonl(directory / "private-cases.jsonl")}
    choices = load_jsonl(directory / "choices.jsonl")
    path = workspace / "preferences/preferences.jsonl"
    preferences = load_jsonl(path)
    by_id = {str(row["id"]): row for row in preferences}
    added = 0
    skipped = 0
    vetoed = 0
    for choice in choices:
        case = private.get(str(choice.get("case_id", "")))
        if case is None or choice.get("label") == "none":
            skipped += 1
            continue
        verdict = str(choice.get("source_verdict", "ok")) or "ok"
        if verdict != "ok":
            scope = VERDICT_SCOPE[verdict]
            record_veto(workspace, {
                "schema_version": SCHEMA_VERSION,
                "scope": scope,
                "id": str(case["source_unit_id"] if scope == "unit" else case["document_id"]),
                "verdict": verdict,
                "batch": str(meta["name"]),
                "source_case_id": str(case["case_id"]),
            })
            vetoed += 1
            continue
        selected = next((row for row in case["options"] if row["label"] == choice["label"]), None)
        if selected is None:
            fail(f"Unknown choice label for {choice.get('case_id')}")
        unfaithful = {str(item) for item in choice.get("unfaithful", [])}
        if selected["label"] in unfaithful and not str(choice.get("edited_output", "")).strip():
            fail(
                f"Refusing to train on {case['case_id']}: the winning option is flagged as "
                "changing the facts and was never edited"
            )
        chosen = str(choice.get("edited_output") or selected["output"]).strip()
        source = json.dumps({
            "neutral_brief": case["neutral_brief"],
            "rhetorical_role": case["rhetorical_role"],
            "must_preserve": case["must_preserve"],
            "structure": case["structure"],
            "preceding_context": case.get("preceding_context", ""),
            "following_context": case.get("following_context", ""),
        }, ensure_ascii=False)
        reason_parts = list(choice.get("tags", []))
        if choice.get("note"):
            reason_parts.append(str(choice["note"]))
        reason = "; ".join(reason_parts) or "Blind preference selection"
        for rejected_option in case["options"]:
            rejected = str(rejected_option["output"]).strip()
            if rejected_option["label"] == choice["label"] or rejected == chosen:
                continue
            preference_id = stable_id("pref", source, rejected, chosen)
            if preference_id not in by_id:
                added += 1
            by_id[preference_id] = {
                "schema_version": SCHEMA_VERSION,
                "id": preference_id,
                "source": source,
                "rejected": rejected,
                "accepted": chosen,
                "reason": reason,
                "rhetorical_role": case["rhetorical_role"],
                "batch": meta["name"],
                "source_case_id": case["case_id"],
                "chosen_system": "human-edit" if choice.get("edited_output") else selected["system"],
                "rejected_system": rejected_option["system"],
                "confidence": choice.get("confidence", "medium"),
                "voice_dimension": case.get("voice_dimension", ""),
                "rejected_unfaithful": rejected_option["label"] in unfaithful,
                "source_unit_id": str(case.get("source_unit_id", "")),
                "document_id": str(case.get("document_id", "")),
            }
    # A veto has to reach pairs an earlier export already wrote, including ones
    # from other batches that drew on the same source.
    vetoes = load_vetoes(workspace)
    retracted = [
        key for key, row in by_id.items()
        if str(row.get("source_unit_id", "")) in vetoes["unit"]
        or str(row.get("document_id", "")) in vetoes["document"]
    ]
    for key in retracted:
        del by_id[key]
    rows = sorted(by_id.values(), key=lambda row: str(row["id"]))
    atomic_jsonl(path, rows)
    dpo_rows = [{
        "prompt": row["source"],
        "chosen": row["accepted"],
        "rejected": row["rejected"],
        "metadata": {
            "id": row["id"], "reason": row["reason"],
            "role": row["rhetorical_role"], "batch": row.get("batch", ""),
            "voice_dimension": row.get("voice_dimension", ""),
            "rejected_unfaithful": bool(row.get("rejected_unfaithful", False)),
        },
    } for row in rows]
    atomic_jsonl(workspace / "preferences/dpo.jsonl", dpo_rows)
    return {
        "added": added,
        "total": len(rows),
        "skipped": skipped,
        "vetoed_sources": vetoed,
        "retracted": len(retracted),
    }


def score_batch(directory: Path) -> dict[str, Any]:
    meta = load_json(directory / "meta.json")
    if meta.get("purpose") != "eval":
        fail("Only held-out evaluation batches produce system scores")
    keys = {
        str(row["case_id"]): {str(option["label"]): str(option["system"]) for option in row["options"]}
        for row in load_jsonl(directory / "blind-key.jsonl")
    }
    choices = load_jsonl(directory / "choices.jsonl")
    wins: Counter[str] = Counter()
    tags: Counter[str] = Counter()
    verdicts: Counter[str] = Counter()
    unfaithful: Counter[str] = Counter()
    none = 0
    seen: set[str] = set()
    for choice in choices:
        case_id = str(choice.get("case_id", ""))
        if case_id in seen:
            fail(f"Duplicate choice for case: {case_id}")
        seen.add(case_id)
        label = str(choice.get("label", ""))
        if label == "none":
            none += 1
        elif case_id in keys and label in keys[case_id]:
            wins[keys[case_id][label]] += 1
        else:
            fail(f"Unknown evaluation choice: {case_id} / {label}")
        tags.update(str(tag) for tag in choice.get("tags", []))
        verdicts[str(choice.get("source_verdict", "ok")) or "ok"] += 1
        for flagged in choice.get("unfaithful", []):
            if case_id in keys and str(flagged) in keys[case_id]:
                unfaithful[keys[case_id][str(flagged)]] += 1
    contrast_cases = sum(
        1 for case_id in seen
        if {"authentic-reference", "voice-stripped-authentic"} <= set(keys.get(case_id, {}).values())
    )
    return {
        "batch": meta["name"],
        "evaluated": len(seen),
        "missing": len(keys) - len(seen),
        "none_acceptable": none,
        "wins": dict(wins.most_common()),
        "flags": dict(tags.most_common()),
        "source_verdicts": dict(verdicts.most_common()),
        "unfaithful_by_system": dict(unfaithful.most_common()),
        "calibration": {
            "content_matched_cases": contrast_cases,
            "authentic_wins": wins.get("authentic-reference", 0),
            "voice_stripped_wins": wins.get("voice-stripped-authentic", 0),
        },
    }


def command_export(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    secure_workspace(workspace)
    result = export_preferences(workspace, batch_dir(workspace, args.batch))
    print(json.dumps(result, indent=2))


def command_score(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    result = score_batch(batch_dir(workspace, args.batch))
    print(json.dumps(result, indent=2))


def command_eligibility(args: argparse.Namespace) -> None:
    """Report which sources the author has ruled out, without corpus text."""
    workspace = Path(args.workspace).expanduser().resolve()
    rows = load_jsonl(workspace / "rlhf/eligibility.jsonl")
    verdicts: Counter[str] = Counter(str(row.get("verdict", "")) for row in rows)
    scopes: Counter[str] = Counter(str(row.get("scope", "")) for row in rows)
    print(json.dumps({
        "vetoes": len(rows),
        "by_verdict": dict(verdicts.most_common()),
        "by_scope": dict(scopes.most_common()),
    }, indent=2))


def command_status(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    root = workspace / "rlhf/batches"
    rows = []
    for directory in sorted(path for path in root.iterdir() if path.is_dir()) if root.exists() else []:
        meta_path = directory / "meta.json"
        if not meta_path.exists():
            continue
        meta = load_json(meta_path)
        choices = load_jsonl(directory / "choices.jsonl")
        rows.append({
            "name": meta.get("name"), "purpose": meta.get("purpose"),
            "model": meta.get("model"), "completed": len(choices),
            "total": meta.get("count"),
        })
    print(json.dumps(rows, indent=2))


class EvalServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, address: tuple[str, int], handler: type[BaseHTTPRequestHandler], workspace: Path, directory: Path):
        super().__init__(address, handler)
        self.workspace = workspace
        self.directory = directory
        self.meta = load_json(directory / "meta.json")
        self.cases = load_jsonl(directory / "blind-cases.jsonl")
        self.assets = Path(__file__).resolve().parent.parent / "assets/rlhf"
        self.token = secrets.token_urlsafe(24)
        self.write_lock = threading.Lock()
        self.sources = {
            str(row["case_id"]): row
            for row in load_jsonl(directory / "private-cases.jsonl")
        }

    def apply_source_verdict(self, choice: dict[str, Any]) -> None:
        """Turn a "bad source" rejection into a veto future batches will honour.

        Only the source identity crosses over, never which option won, so this
        cannot leak a held-out label into training selection.
        """
        verdict = str(choice.get("source_verdict", "ok")) or "ok"
        if verdict == "ok":
            return
        case = self.sources.get(str(choice.get("case_id", "")))
        if case is None:
            return
        scope = VERDICT_SCOPE[verdict]
        record_veto(self.workspace, {
            "schema_version": SCHEMA_VERSION,
            "scope": scope,
            "id": str(case["source_unit_id"] if scope == "unit" else case["document_id"]),
            "verdict": verdict,
            "batch": str(self.meta.get("name", "")),
            "source_case_id": str(case["case_id"]),
        })


class EvalHandler(BaseHTTPRequestHandler):
    server: EvalServer

    def log_message(self, format_string: str, *args: Any) -> None:
        print(f"{self.address_string()} - {format_string % args}", file=sys.stderr)

    def secure_headers(self, content_type: str) -> None:
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("Content-Security-Policy", "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")

    def json_response(self, status: int, payload: Any) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.secure_headers("application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def file_response(self, path: Path, content_type: str) -> None:
        try:
            body = path.read_bytes()
        except FileNotFoundError:
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        self.send_response(HTTPStatus.OK)
        self.secure_headers(content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def allowed_host(self) -> bool:
        host = self.headers.get("Host", "").split(":", 1)[0].strip("[]")
        return host in {"127.0.0.1", "localhost"}

    def allowed_origin(self) -> bool:
        origin = self.headers.get("Origin")
        if not origin:
            return True
        parsed = urllib.parse.urlparse(origin)
        return parsed.scheme == "http" and parsed.hostname in {"127.0.0.1", "localhost"}

    def do_GET(self) -> None:
        if not self.allowed_host():
            self.send_error(HTTPStatus.FORBIDDEN)
            return
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            self.file_response(self.server.assets / "index.html", "text/html; charset=utf-8")
        elif path == "/app.css":
            self.file_response(self.server.assets / "app.css", "text/css; charset=utf-8")
        elif path == "/app.js":
            self.file_response(self.server.assets / "app.js", "text/javascript; charset=utf-8")
        elif path == "/api/state":
            choices = load_jsonl(self.server.directory / "choices.jsonl")
            self.json_response(HTTPStatus.OK, {
                "meta": self.server.meta,
                "cases": self.server.cases,
                "choices": choices,
                "tags": sorted(TAGS),
                "source_verdicts": [row for row in SOURCE_VERDICTS if row != "ok"],
                "token": self.server.token,
            })
        else:
            self.send_error(HTTPStatus.NOT_FOUND)

    def read_payload(self) -> Optional[dict[str, Any]]:
        if not self.allowed_host() or not self.allowed_origin():
            self.send_error(HTTPStatus.FORBIDDEN)
            return None
        if self.headers.get("Content-Type", "").split(";", 1)[0] != "application/json":
            self.send_error(HTTPStatus.UNSUPPORTED_MEDIA_TYPE)
            return None
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self.send_error(HTTPStatus.BAD_REQUEST)
            return None
        if length < 2 or length > 25000:
            self.send_error(HTTPStatus.REQUEST_ENTITY_TOO_LARGE)
            return None
        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            self.send_error(HTTPStatus.BAD_REQUEST)
            return None
        if not isinstance(payload, dict) or payload.get("token") != self.server.token:
            self.send_error(HTTPStatus.FORBIDDEN)
            return None
        return payload

    def do_POST(self) -> None:
        payload = self.read_payload()
        if payload is None:
            return
        path = urllib.parse.urlparse(self.path).path
        if path == "/api/choice":
            case_id = str(payload.get("case_id", ""))
            case = next((row for row in self.server.cases if row["case_id"] == case_id), None)
            if case is None:
                self.json_response(HTTPStatus.BAD_REQUEST, {"error": "Unknown case"})
                return
            try:
                choice = validate_choice(case, payload)
            except SystemExit as exc:
                self.json_response(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
                return
            with self.server.write_lock:
                choices = {str(row["case_id"]): row for row in load_jsonl(self.server.directory / "choices.jsonl")}
                choices[case_id] = choice
                ordered = [choices[row["case_id"]] for row in self.server.cases if row["case_id"] in choices]
                atomic_jsonl(self.server.directory / "choices.jsonl", ordered)
                self.server.apply_source_verdict(choice)
            self.json_response(HTTPStatus.OK, {"saved": True, "completed": len(ordered), "total": len(self.server.cases)})
        elif path == "/api/finish":
            choices = load_jsonl(self.server.directory / "choices.jsonl")
            if len(choices) != len(self.server.cases):
                self.json_response(HTTPStatus.CONFLICT, {"error": "Complete every case before revealing results"})
                return
            try:
                if self.server.meta.get("purpose") == "preference":
                    result = export_preferences(self.server.workspace, self.server.directory)
                else:
                    result = score_batch(self.server.directory)
            except SystemExit as exc:
                self.json_response(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
                return
            self.json_response(HTTPStatus.OK, result)
        elif path == "/api/shutdown":
            self.json_response(HTTPStatus.OK, {"stopping": True})
            threading.Thread(target=self.server.shutdown, daemon=True).start()
        else:
            self.send_error(HTTPStatus.NOT_FOUND)


def command_serve(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    secure_workspace(workspace)
    directory = batch_dir(workspace, args.batch)
    if not (directory / "meta.json").exists():
        fail(f"Unknown batch: {args.batch}")
    server = EvalServer(("127.0.0.1", args.port), EvalHandler, workspace, directory)
    port = server.server_address[1]
    url = f"http://127.0.0.1:{port}/"
    print(url, flush=True)
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    subparsers = root.add_subparsers(dest="command", required=True)

    prepare = subparsers.add_parser("prepare", help="Generate a local blind preference or held-out evaluation batch")
    prepare.add_argument("--workspace", required=True)
    prepare.add_argument("--name", required=True)
    prepare.add_argument("--purpose", choices=("preference", "eval"), required=True)
    prepare.add_argument("--model", default="qwen3:4b")
    prepare.add_argument("--limit", type=int, default=20)
    prepare.add_argument("--seed", default="jessify-rlhf")
    prepare.add_argument("--resume", action="store_true")
    prepare.add_argument("--adapter-path")
    prepare.add_argument("--mlx-model", default="mlx-community/Qwen3-4B-4bit")
    prepare.add_argument(
        "--min-voice-families", type=int, default=3,
        help="Distinct voice devices a passage must use to be worth judging",
    )
    prepare.add_argument(
        "--max-specificity", type=float, default=6.0,
        help="Ceiling on distinct one-off references per 100 words",
    )
    prepare.add_argument(
        "--max-fact-pressure", type=float, default=6.0,
        help="Ceiling on required facts per 100 words of the replaced passage",
    )
    prepare.add_argument(
        "--no-contrast", dest="contrast", action="store_false",
        help="Skip the content-matched voice-stripped option",
    )
    prepare.set_defaults(function=command_prepare, contrast=True)

    serve = subparsers.add_parser("serve", help="Launch the loopback-only blind labeling app")
    serve.add_argument("--workspace", required=True)
    serve.add_argument("--batch", required=True)
    serve.add_argument("--port", type=int, default=0)
    serve.add_argument("--no-open", action="store_true")
    serve.set_defaults(function=command_serve)

    export = subparsers.add_parser("export-preferences", help="Export a completed training batch to DPO pairs")
    export.add_argument("--workspace", required=True)
    export.add_argument("--batch", required=True)
    export.set_defaults(function=command_export)

    score = subparsers.add_parser("score", help="Score a held-out evaluation batch")
    score.add_argument("--workspace", required=True)
    score.add_argument("--batch", required=True)
    score.set_defaults(function=command_score)

    status = subparsers.add_parser("status", help="Show local batch progress without corpus text")
    status.add_argument("--workspace", required=True)
    status.set_defaults(function=command_status)

    eligibility = subparsers.add_parser(
        "eligibility", help="Show which sources author feedback has ruled out",
    )
    eligibility.add_argument("--workspace", required=True)
    eligibility.set_defaults(function=command_eligibility)
    return root


def main() -> None:
    args = parser().parse_args()
    if getattr(args, "limit", 1) < 1:
        fail("--limit must be at least 1")
    args.function(args)


if __name__ == "__main__":
    main()
