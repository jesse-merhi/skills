#!/usr/bin/env python3
"""Rewrite any text in the author's measured voice, then verify it landed."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import math
import re
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path
from typing import Any, Optional


OLLAMA_BASE = "http://127.0.0.1:11434"
NUMBER_RE = re.compile(r"\d[\d,.]*")
REFERENCE_RE = re.compile(r"\b[A-Z][A-Za-z0-9.\-]{2,}\b|\b[A-Z]{2,6}\b|`[^`]+`")
META_LEAK_RE = re.compile(
    r"\b(?:style card|these instructions|rewritten version|the rewrite|"
    r"revised passage|as requested|the author's (?:voice|range|style))\b",
    flags=re.IGNORECASE,
)


def fail(message: str) -> None:
    raise SystemExit(message)


def load_voice_module() -> Any:
    path = Path(__file__).resolve().parent / "jessify-voice"
    loader = importlib.machinery.SourceFileLoader("jessify_voice", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


voice = load_voice_module()


def numbers(text: str) -> Counter[str]:
    return Counter(match.replace(",", "") for match in NUMBER_RE.findall(text))


def references(text: str) -> set[str]:
    """Collect proper names, acronyms, and code spans, but not sentence openers.

    Every sentence starts with a capital, so matching capitalisation alone
    reports "However" and "This" as names a rewrite dropped. Only capitals seen
    away from the start of a sentence count, which deliberately under-reports: a
    name that appears exactly once, at the start of its only sentence, is missed.
    That is the safer direction for an advisory check whose noise would otherwise
    be ignored. Numbers are the hard gate and are matched everywhere.
    """
    found = {match.strip("`").lower() for match in re.findall(r"`[^`]+`", text)}
    body = re.sub(r"`[^`]+`", " ", text)
    for sentence in voice.sentences(body):
        tail = sentence[1:] if sentence else ""
        found.update(match.lower() for match in re.findall(r"\b[A-Z][A-Za-z0-9.\-]{2,}\b", tail))
        found.update(match.lower() for match in re.findall(r"\b[A-Z]{2,6}\b", sentence))
    return {item for item in found if item not in {"i", "a", "the"}}


def faithfulness(source: str, candidate: str) -> dict[str, Any]:
    """Check what a voice change must never touch: the numbers and the names.

    General word overlap is useless here, because rewriting the voice is
    supposed to replace most of the vocabulary. Quantities and proper names are
    the part that has to survive intact.
    """
    source_numbers = numbers(source)
    candidate_numbers = numbers(candidate)
    missing_numbers = sorted((source_numbers - candidate_numbers).elements())
    source_references = references(source)
    missing_references = sorted(source_references - references(candidate))
    return {
        "numbers_kept": not missing_numbers,
        "missing_numbers": missing_numbers,
        "missing_references": missing_references,
        "reference_recall": round(
            1.0 - len(missing_references) / max(1, len(source_references)), 3
        ),
    }


def ollama_generate(model: str, prompt: str, temperature: float, max_tokens: int) -> str:
    body = {
        "model": model, "prompt": prompt, "stream": False, "think": False,
        "keep_alive": "10m",
        "options": {"temperature": temperature, "num_ctx": 16384, "num_predict": max_tokens},
    }
    request = urllib.request.Request(
        f"{OLLAMA_BASE}/api/generate",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    for attempt in range(2):
        try:
            with urllib.request.urlopen(request, timeout=600) as response:
                payload = json.loads(response.read().decode("utf-8"))
            break
        except socket.timeout:
            if attempt == 0:
                continue
            fail("Local model timed out twice")
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            fail(f"Local model request failed: {exc}")
    output = str(payload.get("response", "")).strip()
    return re.sub(r"\A<think>[\s\S]*?</think>\s*", "", output).strip()


def command_generate(command: str, prompt: str) -> str:
    result = subprocess.run(
        command, input=prompt, text=True, capture_output=True, shell=True, check=False,
    )
    if result.returncode != 0:
        fail(f"Generator command failed: {result.stderr.strip()[:400]}")
    return result.stdout.strip()


def generate(args: argparse.Namespace, prompt: str, temperature: float, budget: int) -> str:
    if args.command:
        return command_generate(args.command, prompt)
    return ollama_generate(args.model, prompt, temperature, budget)


def retrieve_examples(
    workspace: Path, source: str, limit: int, exclude_documents: set[str] = frozenset(),
) -> list[dict[str, Any]]:
    """Pick corpus passages that share vocabulary with the input, weighted to voice."""
    units = voice.load_jsonl(workspace / "corpus/units.jsonl")
    eligible = [
        row for row in units
        if row.get("quality") in {"canonical", "usable"}
        and len(voice.words(voice_text(row))) >= 60
        and str(row.get("document_id", "")) not in exclude_documents
        # Never hand back the passage being rewritten. Verbatim overlap only
        # catches the easy case: if the input is a paraphrase of something in the
        # corpus, pass --exclude-document as well.
        and not shares_long_phrase(source, voice_text(row))
    ]
    if not eligible:
        fail("No eligible corpus passages; run jessify-data ingest first")
    query = {word.lower() for word in voice.words(source)}
    frequency: Counter[str] = Counter()
    for row in eligible:
        frequency.update({word.lower() for word in voice.words(voice_text(row))})
    total = len(eligible)
    scored: list[tuple[float, dict[str, Any]]] = []
    for row in eligible:
        counts = Counter(word.lower() for word in voice.words(voice_text(row)))
        score = sum(
            (1.0 + math.log(counts[token])) * math.log((total + 1) / (frequency[token] + 1))
            for token in query if token in counts
        )
        scored.append((score, row))
    scored.sort(key=lambda item: (-item[0], str(item[1].get("id", ""))))
    return [row for score, row in scored[:limit] if score > 0]


def voice_text(row: dict[str, Any]) -> str:
    return str(row.get("plain_text") or row.get("text") or "")


def shares_long_phrase(left: str, right: str, size: int = 9) -> bool:
    left_words = [word.lower() for word in voice.words(left)]
    right_words = [word.lower() for word in voice.words(right)]
    if min(len(left_words), len(right_words)) < size:
        return False
    grams = {
        tuple(left_words[index:index + size])
        for index in range(len(left_words) - size + 1)
    }
    return any(
        tuple(right_words[index:index + size]) in grams
        for index in range(len(right_words) - size + 1)
    )


def build_prompt(card: str, examples: list[dict[str, Any]], source: str, notes: list[str]) -> str:
    blocks = "\n\n".join(
        f"EXAMPLE {index}:\n{voice_text(row)}" for index, row in enumerate(examples, 1)
    )
    correction = ""
    if notes:
        correction = (
            "\nThe previous attempt missed the author's range. Fix exactly this:\n"
            + "\n".join(f"- {note}" for note in notes)
            + "\n"
        )
    return f"""{card}
## Passages the author actually wrote

{blocks}

## Your task

Rewrite the SOURCE below so it reads as though this author wrote it.

Keep every fact, number, name, claim, and the order they appear in. Change the
prose completely: do not edit the source sentence by sentence, because its
rhythm will survive the edit. Write it again from what it says.

Write as this author, in the first person. If the source refers to "the author",
"the writer", or the person in the third person, that is the author being talked
about, so say I and me instead.

Do not explain what you did. Do not add a preface, a title, or a closing
comment. Return only the rewritten prose.
{correction}
SOURCE:
{source}
"""


def clean_output(text: str) -> str:
    text = re.sub(r"\A(?:here(?:'s| is)[^\n:]*:|rewritten[^\n:]*:)\s*", "", text, flags=re.IGNORECASE)
    text = re.sub(r"^#+\s.*$", "", text, flags=re.MULTILINE)
    return text.strip()


def attempt(args: argparse.Namespace, profile: dict[str, Any], prompt: str,
            source: str, temperature: float, budget: int,
            examples: list[dict[str, Any]]) -> Optional[dict[str, Any]]:
    draft = clean_output(generate(args, prompt, temperature, budget))
    minimum = max(20, 0.4 * len(voice.words(source)))
    if len(voice.words(draft)) < minimum:
        return {"rejected": f"only {len(voice.words(draft))} words, needed {minimum:.0f}"}
    leak = META_LEAK_RE.search(draft)
    if leak:
        return {"rejected": f"talked about the task: {leak.group(0)!r}"}
    checked = faithfulness(source, draft)
    scored = voice.score_text(profile, draft)
    copied = [
        index for index, row in enumerate(examples, 1)
        if shares_long_phrase(voice_text(row), draft)
    ]
    return {
        "rejected": "",
        "text": draft,
        "distance": scored["distance"],
        "deviations": scored["deviations"],
        "faithful": checked["numbers_kept"],
        "faithfulness": checked,
        "copied_examples": copied,
    }


def read_source(args: argparse.Namespace) -> str:
    text = Path(args.file).expanduser().read_text(encoding="utf-8") if args.file else sys.stdin.read()
    text = text.strip()
    if len(voice.words(text)) < 15:
        fail("Give me at least a paragraph to work with")
    return text


def style_card(workspace: Path) -> str:
    return subprocess.run(
        [str(Path(__file__).resolve().parent / "jessify-voice"), "card", "--workspace", str(workspace)],
        capture_output=True, text=True, check=True,
    ).stdout


def command_rewrite(args: argparse.Namespace) -> None:
    workspace = Path(args.workspace).expanduser().resolve()
    profile = voice.load_profile(workspace)
    source = read_source(args)
    card = style_card(workspace)
    examples = retrieve_examples(
        workspace, source, args.examples, set(args.exclude_document or []),
    )
    budget = min(2400, max(200, round(len(voice.words(source)) * 2.4)))

    tried: list[dict[str, Any]] = []
    prompt = build_prompt(card, examples, source, [])
    for index in range(args.candidates):
        result = attempt(args, profile, prompt, source, 0.6 + 0.15 * index, budget, examples)
        if result.get("rejected"):
            print(f"draft {index + 1}: rejected, {result['rejected']}", file=sys.stderr)
            continue
        tried.append(result)
        print(
            f"draft {index + 1}: distance {result['distance']}"
            f"{' COPIED from example ' + str(result['copied_examples']) if result['copied_examples'] else ''}",
            file=sys.stderr,
        )

    clean = [row for row in tried if not row["copied_examples"]] or tried
    faithful = [row for row in clean if row["faithful"]] or clean
    if not faithful:
        fail("Every draft was rejected before scoring; try --candidates 5 or a stronger model")
    best = min(faithful, key=lambda row: row["distance"])

    for round_index in range(args.revisions):
        if best["distance"] <= args.target and best["faithful"]:
            break
        notes = voice.revision_notes(best, limit=4)
        revised = attempt(
            args, profile, build_prompt(card, examples, source, notes), source, 0.5, budget,
            examples,
        )
        if revised.get("rejected"):
            print(f"revision {round_index + 1}: rejected, {revised['rejected']}", file=sys.stderr)
            continue
        print(f"revision {round_index + 1}: distance {revised['distance']}", file=sys.stderr)
        better = revised["distance"] < best["distance"]
        no_worse_copying = not revised["copied_examples"] or best["copied_examples"]
        if better and no_worse_copying and (revised["faithful"] or not best["faithful"]):
            best = revised

    if args.json:
        print(json.dumps(best, indent=2, ensure_ascii=False))
        return
    print(best["text"])
    print(
        f"\n--- voice distance {best['distance']} "
        f"(author's own passages average {args.reference_distance}) ---",
        file=sys.stderr,
    )
    if not best["faithful"]:
        print(f"WARNING numbers changed: missing {best['faithfulness']['missing_numbers']}", file=sys.stderr)
    if best["copied_examples"]:
        print(f"WARNING lifted a phrase from example {best['copied_examples']}", file=sys.stderr)
    if best["faithfulness"]["missing_references"]:
        print(
            f"check these names survived: {best['faithfulness']['missing_references'][:8]}",
            file=sys.stderr,
        )
    for note in voice.revision_notes(best, limit=3):
        print(f"still off: {note}", file=sys.stderr)


def command_prompt(args: argparse.Namespace) -> None:
    """Emit what to write from, for the model already driving this skill.

    Shelling out to a local model made sense when nothing else was available.
    When a capable model is running the workflow, asking it to supervise a weaker
    one is strictly worse: it writes the draft itself, then uses `check`.
    """
    workspace = Path(args.workspace).expanduser().resolve()
    source = read_source(args)
    card = style_card(workspace)
    examples = retrieve_examples(
        workspace, source, args.examples, set(args.exclude_document or []),
    )
    print(build_prompt(card, examples, source, []))


def command_check(args: argparse.Namespace) -> None:
    """Grade a draft on voice and on the facts a voice change must not touch."""
    workspace = Path(args.workspace).expanduser().resolve()
    profile = voice.load_profile(workspace)
    source = Path(args.source).expanduser().read_text(encoding="utf-8").strip()
    draft = Path(args.draft).expanduser().read_text(encoding="utf-8").strip()
    scored = voice.score_text(profile, draft)
    checked = faithfulness(source, draft)
    lifted = [
        voice_text(row)[:60]
        for row in retrieve_examples(
            workspace, source, args.examples, set(args.exclude_document or []),
        )
        if shares_long_phrase(voice_text(row), draft)
    ]
    passed = (
        scored["distance"] <= args.target
        and checked["numbers_kept"]
        and not lifted
    )
    result = {
        "passed": passed,
        "distance": scored["distance"],
        "target": args.target,
        "revise": voice.revision_notes(scored, limit=args.limit),
        "missing_numbers": checked["missing_numbers"],
        "missing_names": checked["missing_references"][:8],
        "lifted_from_corpus": lifted,
        "too_short": scored["too_short"],
    }
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        verdict = "in range" if passed else "not there yet"
        print(f"{verdict}: distance {scored['distance']} (target {args.target})")
        if scored["too_short"]:
            print(f"  note: {scored['too_short']}")
        for note in result["revise"]:
            print(f"  - {note}")
        if checked["missing_numbers"]:
            print(f"  ! numbers dropped: {checked['missing_numbers']}")
        if result["missing_names"]:
            print(f"  ? names to confirm: {result['missing_names']}")
        for phrase in lifted:
            print(f"  ! lifted from the corpus: {phrase}...")
    raise SystemExit(0 if passed else 1)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    subparsers = root.add_subparsers(dest="mode", required=True)

    def shared(sub: argparse.ArgumentParser) -> None:
        sub.add_argument("--workspace", required=True)
        sub.add_argument("--examples", type=int, default=4)
        sub.add_argument("--exclude-document", action="append",
                         help="Corpus document_id to keep out of retrieval; repeatable")

    prompt = subparsers.add_parser(
        "prompt", help="Print the style card, examples, and task for you to write from",
    )
    shared(prompt)
    prompt.add_argument("--file", help="Text to rewrite; omit to read stdin")
    prompt.set_defaults(function=command_prompt)

    check = subparsers.add_parser(
        "check", help="Grade your draft on voice and on preserved facts",
    )
    shared(check)
    check.add_argument("--source", required=True, help="The text you rewrote")
    check.add_argument("--draft", required=True, help="Your rewrite")
    check.add_argument("--target", type=float, default=0.03)
    check.add_argument("--limit", type=int, default=5)
    check.add_argument("--json", action="store_true")
    check.set_defaults(function=command_check)

    auto = subparsers.add_parser(
        "auto", help="Unattended loop against a separate generator, for private or batch work",
    )
    shared(auto)
    auto.add_argument("--file", help="Text to rewrite; omit to read stdin")
    auto.add_argument("--command", help="Generator CLI taking a prompt on stdin")
    auto.add_argument("--model", default="qwen3:14b", help="Local Ollama model when no --command")
    auto.add_argument("--candidates", type=int, default=3)
    auto.add_argument("--revisions", type=int, default=2)
    auto.add_argument("--target", type=float, default=0.03)
    auto.add_argument("--reference-distance", type=float, default=0.013,
                      help="Shown for context: distance the author's own prose scores")
    auto.add_argument("--json", action="store_true")
    auto.set_defaults(function=command_rewrite)
    return root


def main() -> None:
    args = parser().parse_args()
    if getattr(args, "candidates", 1) < 1:
        fail("--candidates must be at least 1")
    args.function(args)


if __name__ == "__main__":
    main()
