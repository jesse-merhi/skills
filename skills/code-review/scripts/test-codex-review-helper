#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
harness="$script_dir/test-codex-review-helper.py"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$harness" "$@"
fi

if command -v python >/dev/null 2>&1; then
  exec python "$harness" "$@"
fi

echo "Python 3 is required to run test-codex-review-helper." >&2
exit 127
