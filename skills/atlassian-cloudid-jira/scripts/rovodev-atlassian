#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: rovodev-atlassian --site https://SITE.atlassian.net REQUEST...' \
    '' \
    'Runs one read-only Atlassian request through the authenticated Rovo Dev gateway.'
}

site_url=''

while (($# > 0)); do
  case "$1" in
    --site)
      if (($# < 2)); then
        printf 'Missing value for --site.\n' >&2
        usage >&2
        exit 2
      fi
      site_url="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -* )
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ ! "$site_url" =~ ^https://[A-Za-z0-9.-]+\.atlassian\.net/?$ ]]; then
  printf 'Expected --site to be an https://*.atlassian.net URL.\n' >&2
  exit 2
fi

if (($# == 0)); then
  printf 'A read request is required.\n' >&2
  usage >&2
  exit 2
fi

if ! command -v acli >/dev/null 2>&1; then
  printf 'acli is not installed or is not on PATH.\n' >&2
  exit 127
fi

request="$*"
gateway_prompt="Use the authenticated Atlassian MCP tools read-only on site_url exactly ${site_url}. Do not use another Atlassian site. ${request} Do not create, edit, delete, or comment on anything. Return the live Jira or Confluence result and include the JQL or CQL used when applicable."

exec env NO_COLOR=1 TERM=dumb acli rovodev legacy "$gateway_prompt"
